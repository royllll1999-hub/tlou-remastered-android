index 504e293..b47d386 100644
--- a/gow3_pc/gpu/shim/gow3_movie.cpp
+++ b/gow3_pc/gpu/shim/gow3_movie.cpp
@@ -1,6 +1,7 @@
 #include "gow3_movie.h"
