@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * EXPERIMENT ONLY: make AOT-only prime splitting effective in the pinned TLOU
+ * native APK without replacing its proven FEX/GPU binaries.
+ *
+ * The launcher sends TLOU_AOT_SPLIT_PRIME=1, but the release-packaging workflow
+ * explicitly preserves an older gow3-probe and libgow3gpu. Their newer thread
+ * policy functions are not compiled into that binary. The AOT libgow3cpu.so is
+ * already LD_PRELOADed for AOT worker-stack compatibility. Interpose the real
+ * name-setting call used by Common::SetCurrentThreadName in libgow3gpu,
+ * applying affinity only after naming the TWO critical threads succeeds.
+ * FEX is untouched. No APK should be published without on-device A/B evidence.
+ */
+#include "android_cpu_policy.h"
+#include <dlfcn.h>
+#include <pthread.h>
+#include <cstring>
+#include <cstdio>
+
+__attribute__((constructor)) static void init_aot_affinity() {
+    // The process receives BB_AOT and TLOU_AOT_SPLIT_PRIME before dlopen.
+    if (tlou_aot_split_prime_enabled()) tlou_cpu_policy_prepare();
+}
+
+extern "C" __attribute__((visibility("default")))
+int pthread_setname_np(pthread_t thread, const char* name) {
+    using Original = int (*)(pthread_t, const char*);
+    static Original original = reinterpret_cast<Original>(
+        dlsym(RTLD_NEXT, "pthread_setname_np"));
+    if (!original) return ENOSYS;
+    const int rc = original(thread, name);
+    if (rc || !pthread_equal(thread, pthread_self()) ||
+        !tlou_aot_split_prime_enabled()) return rc;
+    // Linux allows 15 visible bytes; only the two known names are selected.
+    const char* role = nullptr;
+    if (!std::strncmp(name, "shadPS4:GpuComm", 15)) role = "GPU command";
+    if (!std::strncmp(name, "gow3:DrawRec", 12)) role = "draw recording";
+    if (role) tlou_cpu_policy_apply(role, 1);
+    return rc;
+}
diff --git a/android/aot/aot_local.py b/android/aot/aot_local.py
new file mode 100644
index 0000000..fec7400
--- /dev/null
+++ b/android/aot/aot_local.py
@@ -0,0 +1,779 @@
+#!/usr/bin/env python3
+"""Experimental TLOU AOT compiler adapter. Requires a local bb-recomp binary.
+
+Prepares TLOU's G3PROBE5 image and translates its x86-64 guest code to ARM64
+on the player's own device. This is not yet a game runtime integration.
+Never upload games, prepared images or generated .so files to CI/GitHub.
+"""
+from __future__ import annotations
+
+# PS4 fiber callbacks can replace the entire x86 register file. The compiled
+# caller must reload callee-saved GPRs from GuestState after a callback.
+# The upstream bb-recomp --resume shard key includes the calleeSaved option.
+NATIVE_FIBER_CPU_FLAGS = ("--tso", "--resume-entries", "--no-callee-saved")
+
+
+def native_guest_flags(profile: str) -> tuple[str, ...]:
+    """No-TSO is strictly opt-in; fiber and resume entry flags never change."""
+    if profile not in ("v3", "v4", "v5", "off"):
+        raise ValueError("Unrecognized TSO lowering profile")
+    return tuple(f for f in NATIVE_FIBER_CPU_FLAGS
+                 if profile != "off" or f != "--tso")
+
+
+# AOT vs FEX gameplay (logs 28/29): six workers 3.00 vs 2.52 CPU cores.
+# Keep --tso and fiber ABI safeguards. The verified PS4 1.11 native image has
+# all static patches built in, --no-game-hooks, and no runtime x86 patch writes.
+# The pinned compiler explicitly supports -O2 and --no-dirty-check.
+# Native patches are stored as alternatives of affected functions. Their
+# original entry checks are REQUIRED for bb-recomp variant redirection.
+# Keep LLVM -O2; never use --no-dirty-check with --variants.
+AOT_111_PERFORMANCE_FLAGS = ("-O2",)
+AOT_111_PERFORMANCE_PROFILE = "tlou-111-llvmO2-native-variants-v1"
