+        } else if (op == OpCompositeConstruct && n == 5 &&
+                   original[i + 1] == uint32_vec2 && uint32_vec2 != 0) {
+            coord_vec_id = original[i + 2];
+            coord_x_id = original[i + 3];
+            ++coord_vectors;
+        } else if (op == OpImageWrite) {
+            ++writes;
