new file mode 100644
index 0000000..9aabdfc
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_aot_tso_litmus.cpp
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// ARM64 multicore screening of release/acquire mappings. Statistical testing
+// cannot prove all x86-TSO behaviours or validate mixed non-atomic SIMD code.
+#include <atomic>
+#include <barrier>
+#include <cassert>
+#include <cstdio>
+#include <thread>
+#if !defined(__aarch64__)
+#error "ARM64-only memory litmus"
+#endif
+constexpr unsigned Repeats=35000;
+void MessagePassing() {
+    std::atomic<int> data{0},flag{0};
+    std::barrier gate(3),done(3);
+    int bad=0,observed=0;
+    std::jthread producer([&]{
+        for(unsigned i=0;i<Repeats;++i){
+            gate.arrive_and_wait();
+            data.store(1,std::memory_order_relaxed);
+            flag.store(1,std::memory_order_release);
+            done.arrive_and_wait();
+        }
+    });
+    std::jthread consumer([&]{
+        for(unsigned i=0;i<Repeats;++i){
+            gate.arrive_and_wait();
+            if(flag.load(std::memory_order_acquire)==1){
+                ++observed;
+                if(data.load(std::memory_order_relaxed)!=1)++bad;
+            }
+            done.arrive_and_wait();
+        }
+    });
+    for(unsigned i=0;i<Repeats;++i){
+        data.store(0,std::memory_order_relaxed);
+        flag.store(0,std::memory_order_relaxed);
+        gate.arrive_and_wait();done.arrive_and_wait();
+    }
+    assert(bad==0);
+    std::printf("TLOU TSO MP ARM64: rounds=%u observed=%d forbidden=%d PASS\n",
+                Repeats,observed,bad);
+}
+void LoadBuffering() {
+    std::atomic<int> x{0},y{0};
+    std::barrier gate(3),done(3);
+    int a=0,b=0,bad=0;
+    std::jthread t0([&]{
+        for(unsigned i=0;i<Repeats;++i){
+            gate.arrive_and_wait();
+            a=y.load(std::memory_order_acquire);
+            x.store(1,std::memory_order_release);
+            done.arrive_and_wait();
+        }
+    });
+    std::jthread t1([&]{
+        for(unsigned i=0;i<Repeats;++i){
+            gate.arrive_and_wait();
+            b=x.load(std::memory_order_acquire);
+            y.store(1,std::memory_order_release);
+            done.arrive_and_wait();
+        }
+    });
+    for(unsigned i=0;i<Repeats;++i){
+        x.store(0,std::memory_order_relaxed);
+        y.store(0,std::memory_order_relaxed);
+        gate.arrive_and_wait();done.arrive_and_wait();
+        bad+=(a==1&&b==1);
+    }
+    assert(bad==0);
+    std::printf("TLOU TSO LB ARM64: rounds=%u forbidden=%d PASS\n",Repeats,bad);
+}
+void StoreBuffering() {
+    std::atomic<int> x{0},y{0};
+    std::barrier gate(3),done(3);
+    int a=0,b=0,zeros=0;
+    std::jthread t0([&]{
+        for(unsigned i=0;i<Repeats;++i){
+            gate.arrive_and_wait();
+            x.store(1,std::memory_order_release);
+            a=y.load(std::memory_order_acquire);
+            done.arrive_and_wait();
+        }
+    });
+    std::jthread t1([&]{
+        for(unsigned i=0;i<Repeats;++i){
+            gate.arrive_and_wait();
+            y.store(1,std::memory_order_release);
+            b=x.load(std::memory_order_acquire);
+            done.arrive_and_wait();
+        }
+    });
+    for(unsigned i=0;i<Repeats;++i){
+        x.store(0,std::memory_order_relaxed);
+        y.store(0,std::memory_order_relaxed);
+        gate.arrive_and_wait();done.arrive_and_wait();
+        zeros+=(a==0&&b==0);
+    }
+    // x86-TSO permits store buffering [0,0]. Never reject over-strong
+    // mappings, but report the outcome for later model comparison.
+    std::printf("TLOU TSO SB ARM64: rounds=%u x86-allowed-0-0=%d observational\n",
+                Repeats,zeros);
+}
+void IRIW() {
+    std::atomic<int> x{0},y{0};
+    std::barrier gate(5),done(5);
+    int a=0,b=0,c=0,d=0,forbidden=0;
+    std::jthread writerX([&]{for(unsigned i=0;i<Repeats;++i){
+        gate.arrive_and_wait();x.store(1,std::memory_order_release);done.arrive_and_wait();}});
+    std::jthread writerY([&]{for(unsigned i=0;i<Repeats;++i){
+        gate.arrive_and_wait();y.store(1,std::memory_order_release);done.arrive_and_wait();}});
+    std::jthread readerXY([&]{for(unsigned i=0;i<Repeats;++i){
+        gate.arrive_and_wait();a=x.load(std::memory_order_acquire);
+        b=y.load(std::memory_order_acquire);done.arrive_and_wait();}});
+    std::jthread readerYX([&]{for(unsigned i=0;i<Repeats;++i){
+        gate.arrive_and_wait();c=y.load(std::memory_order_acquire);
+        d=x.load(std::memory_order_acquire);done.arrive_and_wait();}});
+    for(unsigned i=0;i<Repeats;++i){
+        x.store(0,std::memory_order_relaxed);y.store(0,std::memory_order_relaxed);
+        gate.arrive_and_wait();done.arrive_and_wait();
+        forbidden+=(a==1&&b==0&&c==1&&d==0);
+    }
+    assert(forbidden==0);
+    std::printf("TLOU TSO IRIW ARM64: rounds=%u forbidden=%d PASS\n",Repeats,forbidden);
+}
+int main() {
+    MessagePassing();
+    LoadBuffering();
+    StoreBuffering();
+    IRIW();
+}
diff --git a/gow3_pc/tests/test_tlou_aot_tso_outline_bench.cpp b/gow3_pc/tests/test_tlou_aot_tso_outline_bench.cpp
new file mode 100644
index 0000000..7c3f918
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_aot_tso_outline_bench.cpp
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// ARM64 microbench, faithful to fixed guest op size at codegen time.
+// v4: two DMB + native-sized unaligned access INLINED at each operation.
+// v5: same aligned atomic, but a call to shared cold full-fence fallback.
+// This is not an x86-TSO or on-device FPS proof.
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#if !defined(__aarch64__)
+#error "ARM64 only"
+#endif
+extern "C" std::uint64_t bbr_tso_unaligned_load(std::uint64_t,std::uint32_t);
+extern "C" void bbr_tso_unaligned_store(std::uint64_t,std::uint64_t,std::uint32_t);
+using U64=std::uint64_t;
+constexpr unsigned Iterations=500000;
+
+// Distinct per-width native functions model the compiler's constant IR op size.
+// Never put the inlined v4 fallback behind another out-of-line function.
+template<unsigned Width,bool Outlined>
+__attribute__((noinline)) static U64 Load(const void* p) {
+  static_assert(Width==1||Width==2||Width==4||Width==8);
+  if constexpr(Width==1) {
+    return __atomic_load_n((const std::uint8_t*)p,__ATOMIC_ACQUIRE);
+  } else {
+    if((reinterpret_cast<std::uintptr_t>(p)&(Width-1))!=0) {
+      if constexpr(Outlined) {
+        return bbr_tso_unaligned_load((std::uintptr_t)p,Width);
+      } else {
+        asm volatile("dmb ish" ::: "memory");
+        U64 x=0;
+        __builtin_memcpy(&x,p,Width);
+        asm volatile("dmb ish" ::: "memory");
+        return x;
+      }
+    }
+    if constexpr(Width==2) return __atomic_load_n((const std::uint16_t*)p,__ATOMIC_ACQUIRE);
+    if constexpr(Width==4) return __atomic_load_n((const std::uint32_t*)p,__ATOMIC_ACQUIRE);
+    return __atomic_load_n((const std::uint64_t*)p,__ATOMIC_ACQUIRE);
+  }
+}
+template<unsigned Width,bool Outlined>
+__attribute__((noinline)) static void Store(void* p,U64 x) {
+  static_assert(Width==1||Width==2||Width==4||Width==8);
+  if constexpr(Width==1) {
+    __atomic_store_n((std::uint8_t*)p,(std::uint8_t)x,__ATOMIC_RELEASE);
+  } else {
+    if((reinterpret_cast<std::uintptr_t>(p)&(Width-1))!=0) {
+      if constexpr(Outlined) {
+        bbr_tso_unaligned_store((std::uintptr_t)p,x,Width);
+      } else {
+        asm volatile("dmb ish" ::: "memory");
+        __builtin_memcpy(p,&x,Width);
+        asm volatile("dmb ish" ::: "memory");
+      }
+      return;
+    }
+    if constexpr(Width==2)__atomic_store_n((std::uint16_t*)p,(std::uint16_t)x,__ATOMIC_RELEASE);
+    if constexpr(Width==4)__atomic_store_n((std::uint32_t*)p,(std::uint32_t)x,__ATOMIC_RELEASE);
+    if constexpr(Width==8)__atomic_store_n((std::uint64_t*)p,x,__ATOMIC_RELEASE);
+  }
+}
+struct Result{double ns;U64 checksum;std::array<std::uint8_t,32> last;};
+template<unsigned Width,bool Outlined> static Result Measure(unsigned unaligned) {
+  alignas(64) std::array<std::uint8_t,32> source{},target{};
+  for(unsigned j=0;j<32;++j)source[j]=std::uint8_t(j*7+3);
+  U64 checksum=0;
+  auto start=std::chrono::steady_clock::now();
+  for(unsigned i=0;i<Iterations;++i) {
+    const unsigned offset=(i%100<unaligned)?1:0;
+    U64 x=Load<Width,Outlined>(source.data()+offset);
+    Store<Width,Outlined>(target.data()+offset,x+(i&0xff));
+    checksum+=x;
+  }
+  auto end=std::chrono::steady_clock::now();
+  return {std::chrono::duration<double,std::nano>(end-start).count()/Iterations,checksum,target};
+}
+template<unsigned Width> static void Benchmark(unsigned unaligned) {
+  std::array<std::vector<double>,2> times;
+  for(unsigned trial=0;trial<10;++trial) {
+    const auto v4=Measure<Width,false>(unaligned);
+    const auto v5=Measure<Width,true>(unaligned);
+    assert(v4.checksum==v5.checksum && v4.last==v5.last);
+    if(trial>=2){times[0].push_back(v4.ns);times[1].push_back(v5.ns);}
+  }
+  for(auto& v:times) std::sort(v.begin(),v.end());
+  auto old=times[0][times[0].size()/2];
+  auto next=times[1][times[1].size()/2];
+  std::printf("TSO v5 outline ARM64 size=%u unaligned=%u%% v4-inline=%.2fns v5-outlined=%.2fns ratio=%.3f checksum PASS\n",
+              Width,unaligned,old,next,next/old);
+}
+int main() {
+  for(unsigned ratio:{0u,10u,50u}) {
+    Benchmark<1>(ratio);
+    Benchmark<2>(ratio);
+    Benchmark<4>(ratio);
+    Benchmark<8>(ratio);
+  }
+}
diff --git a/gow3_pc/tests/test_tlou_aot_tso_scalar_screen.cpp b/gow3_pc/tests/test_tlou_aot_tso_scalar_screen.cpp
new file mode 100644
index 0000000..2313c68
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_aot_tso_scalar_screen.cpp
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// ARM64 synthetic screen ONLY. Do not infer x86-TSO correctness or FPS.
+// Source conservative lowering: android/aot/patch_recompiler_tso.py.
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+#if !defined(__aarch64__)
+#error "ARM64-only: x86 measurements are misleading"
+#endif
+using Word = std::uint64_t;
+static constexpr unsigned Iterations = 1200000;
+__attribute__((noinline)) static Word ConservativeLoad(const Word* p) {
+    asm volatile("dmb ish" ::: "memory");
+    const Word value = *reinterpret_cast<const volatile Word*>(p);
+    asm volatile("dmb ish" ::: "memory");
+    return value;
+}
+__attribute__((noinline)) static void ConservativeStore(Word* p, Word value) {
+    asm volatile("dmb ish" ::: "memory");
+    *reinterpret_cast<volatile Word*>(p) = value;
+    asm volatile("dmb ish" ::: "memory");
+}
+// Atomic candidate is ONLY legal for adequately aligned scalar guest addresses.
+// SIMD, unaligned, and split-cache-line addresses need a validated fallback.
+__attribute__((noinline)) static Word AtomicAcquireLoad(const Word* p) {
+    return __atomic_load_n(p, __ATOMIC_ACQUIRE);
+}
+__attribute__((noinline)) static void AtomicReleaseStore(Word* p, Word value) {
+    __atomic_store_n(p, value, __ATOMIC_RELEASE);
+}
+using Load = Word(*)(const Word*);
+using Store = void(*)(Word*,Word);
+static double Run(Load load,Store store) {
+    alignas(64) std::array<Word,4> cells{8,20,0,0};
+    Word acc=0;
+    const auto t0=std::chrono::steady_clock::now();
+    for(unsigned i=0;i<Iterations;++i) {
+        const unsigned slot=i&1u;
+        const Word v=load(&cells[slot]);
+        store(&cells[slot+2],v+(i&7u));
+        acc+=v;
+    }
+    const auto t1=std::chrono::steady_clock::now();
+    assert(cells[2]==8+((Iterations-2)&7u));
+    assert(cells[3]==20+((Iterations-1)&7u));
+    assert(acc==(Iterations/2ull)*28);
+    return std::chrono::duration<double,std::nano>(t1-t0).count()/Iterations;
+}
+int main() {
+    std::array<std::vector<double>,2> results;
+    for(unsigned round=0;round<24;++round) for(unsigned pass=0;pass<2;++pass) {
+        const unsigned mode=pass^(round&1u);
+        const double ns=mode==0 ? Run(ConservativeLoad,ConservativeStore)
+                                : Run(AtomicAcquireLoad,AtomicReleaseStore);
+        if(round>3)results[mode].push_back(ns);
+    }
+    for(auto& values:results)std::sort(values.begin(),values.end());
+    const double before=results[0][results[0].size()/2];
+    const double after=results[1][results[1].size()/2];
+    std::printf("TLOU AOT TSO SCALAR SCREEN ARM64: full-fence=%.2f ns/pair acquire-release=%.2f ns/pair ratio=%.3f (aligned scalar synthetic ONLY; NOT gameplay proof)\n",
+                before,after,after/before);
+}
diff --git a/gow3_pc/tests/test_tlou_buffer_descriptor_hpp.cpp b/gow3_pc/tests/test_tlou_buffer_descriptor_hpp.cpp
