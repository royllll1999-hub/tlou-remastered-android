+            "--out",output.getCanonicalPath(),
+            "--compiler",compiler.getCanonicalPath(),
+            "--tso-profile",profile,
+            "--bundle-dir",bundle.getCanonicalPath(),
+            "--options",nativeOptions.getCanonicalPath(),
+            "--jobs","3","--shards","64",
