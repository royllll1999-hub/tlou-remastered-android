+def prepare_native_animation_patch(boot: Path, self_digest: str,
+                                   output: Path,
+                                   options: dict | None = None,
+                                   catalog_mode: bool = False) -> list[str]:
+    """Compile fully byte-verified 1.11 patches into an isolated native image.
+
+    Unspecified options retain the legacy animation-only mode for compatibility
+    with the synthetic regression fixtures. The Android app ALWAYS supplies its
+    current patch-options.json and checks the selected profile before launch.
+
+    The normal FEX boot and the player's SELF are never modified. Every byte
+    guard, including the read-only guards, must match the original linked
+    image before the transactional output file is published.
+    """
+    if KNOWN_EBOOTS.get(self_digest) != "1.11":
+        output.unlink(missing_ok=True)
+        return []
+    import importlib.util
+    profile = Path(__file__).resolve().parents[1] / "tlou_patches.py"
+    spec = importlib.util.spec_from_file_location("tlou_aot_guarded_patches", profile)
+    if not spec or not spec.loader:
+        raise ValueError("Missing verified 1.11 patch profile")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    if self_digest not in module.SELF_SHA256_111:
+        raise ValueError("AOT native patches require verified 1.11 executable")
+    if options is None:
+        groups = {"invalid-animation-output-pointer":
+                  module.BASE_PATCHES_111["invalid-animation-output-pointer"]}
+    else:
+        # On the variant path compile only mandatory stability patches into
+        # the baseline. Every resolution and visual effect (including OFF)
+        # must remain selectable without retranslating other game functions.
+        # Validating selected options here is useful, but NEVER bake those
+        # optional options into the AOT image.
+        module.selected_options(options, "01.11", self_digest)
+        baseline = {"job_sleep": True} if catalog_mode else options
+        groups = module.base_patches_for(baseline, "01.11")
+        if not catalog_mode:
+            groups.update(module.selected_options(options, "01.11", self_digest))
+        # Generic 1.11 AOT job-worker idle-loop optimization. This is not
+        # selected by GPU/SoC/device identity; keep the existing codegen and
+        # launch compatibility unchanged while expanding jump coverage.
+        if options.get("job_sleep", True):
+            groups["native-job-idle-backoff"] = [
+                (0xC87D71, "483de8030000", "483d80000000"),
+            ]
+        if "invalid-animation-output-pointer" not in groups:
+            raise ValueError("Required native animation guard was disabled")
+    cave = groups["invalid-animation-output-pointer"]
+    if len(cave) != 2 or [addr for addr, _, _ in cave] != [0xA623D3, 0xC9FC61]:
+        raise ValueError("Verified 1.11 animation patch changed")
+    info = check_boot(boot)
+    if info["magic"] != "G3PROBE5":
+        raise ValueError("Expected original G3PROBE5 image")
+    start = boot.stat().st_size - info["size"]
+    changes: list[tuple[int, bytes]] = []
+    original_checks: dict[tuple[int, int], bytes] = {}
+    with boot.open("rb") as source:
+        for group, entries in groups.items():
+            for addr, expected_hex, replacement_hex in entries:
+                expected = bytes.fromhex(expected_hex)
+                if not expected or addr < 0 or addr + len(expected) > info["size"]:
+                    raise ValueError("Native patch outside linked guest image: "
+                                     + group + " " + hex(addr))
+                source.seek(start + addr)
+                actual = source.read(len(expected))
+                if actual != expected:
+                    raise ValueError("1.11 native patch guard mismatch: "
+                                     + group + " at " + hex(addr))
+                key = (addr, len(expected))
+                if key in original_checks and original_checks[key] != expected:
+                    raise ValueError("Conflicting original-byte patch guards")
+                original_checks[key] = expected
+                if replacement_hex is None:
+                    continue  # validation only, never write this span
+                replacement = bytes.fromhex(replacement_hex)
+                if len(replacement) != len(expected):
+                    raise ValueError("Native patch changes executable image layout: "
+                                     + group + " at " + hex(addr))
+                for previous_at, previous in changes:
+                    if addr < previous_at + len(previous) and previous_at < addr + len(replacement):
+                        raise ValueError("Overlapping native patches: "
+                                         + group + " at " + hex(addr))
+                changes.append((addr, replacement))
+    output.parent.mkdir(parents=True, exist_ok=True)
+    temp = output.with_suffix(output.suffix + ".tmp")
+    try:
+        shutil.copyfile(boot, temp)
+        with temp.open("r+b") as modified:
+            for addr, data in changes:
+                modified.seek(start + addr)
+                modified.write(data)
+            modified.flush()
+            os.fsync(modified.fileno())
+        if check_boot(temp) != info:
+            raise ValueError("Native boot structure changed")
+        os.replace(temp, output)
+    finally:
+        temp.unlink(missing_ok=True)
+    return list(groups)
+
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def check_self(path: Path) -> None:
+    with path.open("rb") as stream:
+        first = stream.read(32)
+        if len(first) != 32 or first[:4] != b"O\x15=\x1d":
+            raise ValueError(f"Not a PS4 SELF: {path}")
+        seg_count = struct.unpack_from("<H", first, 24)[0]
+        if not 0 < seg_count < 256:
+            raise ValueError(f"Invalid SELF section count: {path}")
+        stream.seek(32 + seg_count * 32)
+        elf = stream.read(64)
+        if elf[:7] != b"\x7fELF\x02\x01\x01" or len(elf) != 64:
+            raise ValueError(f"No plaintext ELF64 in {path}")
+        if struct.unpack_from("<H", elf, 18)[0] != 62:
+            raise ValueError(f"Not x86-64: {path}")
+
+
+def check_boot(path: Path) -> dict:
+    with path.open("rb") as stream:
+        header = stream.read(104)
+        if len(header) != 104:
+            raise ValueError("Truncated boot-linked header")
+        magic, size, entry, ns, nr, ni, _, _, *tail = struct.unpack("<8s12Q", header)
+        mc = tail[-1]
+        if magic not in (b"G3PROBE5", b"BBPROBE5") or not 0 < size <= 512*1024*1024:
+            raise ValueError("Invalid boot image or signature")
+        if not 0 < ns <= 64 or nr > 4_000_000 or ni > 100_000 or not 0 < mc <= 16:
+            raise ValueError("Invalid boot tables")
+        stream.seek(104 + 56 * mc)
+        b = stream.read(8)
+        if len(b) != 8:
+            raise ValueError("Truncated bindings header")
+        nb = struct.unpack("<Q", b)[0]
+        if nb > ni or 104 + 56*mc + 8 + 24*nb + 24*ns + 128*ni + 32*nr + size != path.stat().st_size:
+            raise ValueError("Boot image size mismatch")
+        return {"magic": magic.decode(), "size": size, "entry": entry,
+                "segments": ns, "relocations": nr, "imports": ni,
+                "modules": mc, "bindings": nb}
+
+
+def verify_eboot_image(eboot: Path, boot: Path) -> int:
+    """Check EVERY executable guest byte against the linked image.
+
+    TLOU's linker copies the original x86-64 text as-is, except for the
+    documented FS->GS 9-byte rewrite. This detects an update/base mismatch
+    before LLVM translates an incompatible executable, without checking
+    unrelated gigabytes of assets.
+    """
+    info = check_boot(boot)
+    image_start = boot.stat().st_size - info["size"]
+    header = eboot.read_bytes()
+    if len(header) < 64 or header[:4] != b"O\x15=\x1d":
+        raise ValueError("Expected plaintext PS4 SELF")
+    count = struct.unpack_from("<H", header, 24)[0]
+    base = 32 + count * 32
+    phoff = struct.unpack_from("<Q", header, base + 32)[0]
+    phsize, phnum = struct.unpack_from("<HH", header, base + 54)
+    if phsize != 56 or not 0 < phnum < 256:
+        raise ValueError("Invalid ELF program headers")
+    patches = (b"\x64\x48\x8b\x04\x25\x00\x00\x00\x00",
+               b"\x65\x48\x8b\x04\x25\x00\x00\x00\x00")
+    checked = 0
+    with boot.open("rb") as linked:
+        for index in range(phnum):
+            p = struct.unpack_from("<II6Q", header, base + phoff + 56 * index)
+            kind, flags, _, vaddr, _, filesz, _, _ = p
+            if kind != 1 or not flags & 1 or filesz == 0:
+                continue
+            if vaddr > info["size"] or filesz > info["size"] - vaddr:
+                raise ValueError("Executable segment outside linked image")
+            source_segment = None
+            for i in range(count):
+                f, pos, n, mem = struct.unpack_from("<4Q", header, 32 + i * 32)
+                if f & 0x800 and (f >> 20) & 4095 == index:
+                    if f & 10 or n != filesz or mem != filesz:
+                        raise ValueError("Unsupported compressed/executable SELF segment")
+                    if pos > len(header) or n > len(header) - pos:
+                        raise ValueError("Truncated SELF executable segment")
+                    source_segment = header[pos:pos+n]
+                    break
+            if source_segment is None:
+                raise ValueError("Executable SELF segment missing")
+            linked.seek(image_start + vaddr)
+            actual = linked.read(filesz)
+            expected = source_segment.replace(*patches)
+            if actual != expected:
+                raise ValueError("boot-linked image contains a different eboot (1.00/1.11 mismatch)")
+            checked += filesz
+    if checked == 0:
+        raise ValueError("No executable bytes verified")
+    return checked
+
+
+def effective_game_folder(base_game: Path, boot: Path | None) -> Path:
+    """Use the selected update's merged view, never the original base eboot.
+
+    TLOU boots boot-linked.bin made from tlou-view (base + 1.11 update).
+    Using --game-dir against the base 1.00 ELF while the image has 1.11
+    would produce wrong function offsets and an unusable native library.
+    """
+    if boot is None:
+        return base_game
+    view = boot.parent / "tlou-view"
+    if view.is_dir():
+        if not (view / "eboot.bin").is_file():
+            raise ValueError("Prepared tlou-view is missing the effective eboot.bin")
+        return view.resolve(strict=True)
+    if (boot.parent / "device-ready.json").is_file():
+        raise ValueError("Prepared boot has no tlou-view: refusing to mix game versions")
+    return base_game
+
+
+def prepare(repo: Path, game: Path, out: Path) -> Path:
+    scripts = repo / "gow3_pc/scripts"
+    for script in ("prepare.py", "link_modules.py"):
+        subprocess.run([sys.executable, str(scripts / script), str(game),
+                        "--out", str(out)], check=True)
+    return out / "boot-linked.bin"
+
+
+def stage_boot(source: Path, out: Path) -> Path:
+    src = check_boot(source)
+    if src["magic"] != "G3PROBE5" or src["modules"] != 2:
+        raise ValueError("Expected TLOU G3PROBE5 with both linked PRX modules")
+    out.mkdir(parents=True, exist_ok=True)
+    dest = out / "boot-linked.bin"
+    tmp = out / "boot-linked.bin.tmp"
+    try:
+        with source.open("rb") as read, tmp.open("wb") as write:
+            read.seek(8)
+            write.write(b"BBPROBE5")
+            shutil.copyfileobj(read, write, length=1024*1024)
+        os.replace(tmp, dest)
+    finally:
+        tmp.unlink(missing_ok=True)
+    if check_boot(dest)["magic"] != "BBPROBE5" or dest.stat().st_size != source.stat().st_size:
+        raise ValueError("Boot staging failed")
+    # The compiler's ELF reader expects the module order from link.json.
+    link = source.parent / "link.json"
+    if link.is_file():
+        doc = json.loads(link.read_text())
+        names = [v["file"] for v in doc.get("modules", [])]
+        if names != ["libc.prx", "libSceFios2.prx"]:
+            raise ValueError(f"Unexpected linked module order: {names}")
+        shutil.copyfile(link, out / "link.json")
+    else:
+        (out / "link.json").write_text(json.dumps({"modules": [
+            {"file": "libc.prx"}, {"file": "libSceFios2.prx"}]}))
+    return dest
+
+
+def verify_aot_coverage(stats: Path, meta: dict) -> dict:
+    """Refuse useless native images that mostly contain unsupported-op traps."""
+    import re
+    version = str(meta.get("compiler_version", ""))
+    if version not in {"3-tlou-string", "4-tlou-tso-aligned-ar-v1", "5-tlou-tso-outlined-unaligned-v1"}:
+        raise ValueError("Old bb-recomp compiler: TSO LLVM lowering is missing; rebuild with TLOU TSO tool")
+    if not stats.is_file():
+        raise ValueError("No native compiler coverage report")
+    text = stats.read_text(encoding="utf-8", errors="replace")
+    match = re.search(r"units with bbr_trap \(unsupported ops\): (\d+) \(([\d.]+)%\)", text)
+    if not match:
+        raise ValueError("Native compiler omitted unsupported-op coverage summary")
+    dirty = int(match.group(1))
+    percent = float(match.group(2))
+    count = int(meta.get("unit_count", 0))
+    if count <= 0 or dirty > count:
+        raise ValueError("AOT function coverage count invalid")
+    # Default TLOU v1.11 upstream 1.3.0 --tso produced 60598 dirty
+    # of 75413 units. With the new memory lowering, at most a tiny number
+    # of genuinely unsupported string/vector instructions may remain.
+    if "LoadMemTSO" in text or "StoreMemTSO" in text or percent > 0.25:
+        raise ValueError(f"AOT has {dirty}/{count} units without native code ({percent}%); refusing unusable build")
+    return {"unsupported_units": dirty, "unsupported_percent": percent,
+            "estimated_usable_units": count - dirty, "compiler_version": version}
+
+
+def verify_native_variant_coverage(stats: Path, catalog: dict) -> dict:
+    """Never mark a library ready if ANY requested patch function failed lifting.
+
+    The pinned compiler's summary is written to compile.txt even without
+    --variant-report; count the full group and function coverage. A partial
+    variant catalog must not silently launch with missing visual patches.
+    """
+    report = stats.read_text(encoding="utf-8", errors="replace")
+    pattern = (r"variants:\s+(\d+)\s+groups in the catalogs\s+"
+               r"\((\d+)\s+touch code\),\s+(\d+)\s+variants planned,\s+"
+               r"(\d+)\s+built\s+\([^)]*\),\s+(\d+)\s+skipped,")
+    found = re.search(pattern, report)
+    if not found:
+        raise ValueError("Compiler did not confirm complete native patch variants")
+    declared, touches, planned, built, skipped = map(int, found.groups())
+    required = len(catalog["groups"])
+    if (declared != required or touches != required or planned < required
+            or built != planned or skipped):
+        raise ValueError(
+            f"Incomplete AOT patch variants: {touches}/{required} groups, "
+            f"{built}/{planned} functions, {skipped} skipped; refusing build")
+    return {"groups": declared, "groups_with_code": touches,
+            "variants_planned": planned, "variants_built": built,
+            "variants_skipped": skipped}
+
+
+def available_compile_memory_bytes() -> int:
+    """Actual Linux MemAvailable, not PS4 sparse virtual pool or zram size."""
+    try:
+        for line in Path("/proc/meminfo").read_text(encoding="ascii").splitlines():
+            if line.startswith("MemAvailable:"):
+                parts = line.split()
+                return int(parts[1]) * 1024 if len(parts) >= 3 and parts[2] == "kB" else 0
+    except (OSError, ValueError):
+        pass
+    return 0
+
+
+def select_compile_workers(requested: int, available_bytes: int) -> int:
+    """Avoid AOT codegen's ~2 GiB peak colliding with 8 GB Android LMKD.
+
+    This only changes translation throughput, not code, runtime scheduling,
+    shard count, TSO profile, or FPS. Unknown availability keeps the request.
+    """
+    if available_bytes <= 0:
+        return requested
+    gib = 1024 ** 3
+    ceiling = 1 if available_bytes < 4 * gib else 2 if available_bytes < 6 * gib else requested
+    return max(1, min(requested, ceiling))
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--game", type=Path, required=True,
+                        help="On-device folder containing eboot.bin, sce_module/ and sce_sys/")
+    parser.add_argument("--out", type=Path, required=True, help="Private writable work directory")
+    parser.add_argument("--boot", type=Path, help="Prepared G3PROBE5 boot-linked.bin")
+    parser.add_argument("--compiler", type=Path, help="On-device bb-recomp v1.3+ executable")
+    parser.add_argument("--bundle-dir", type=Path, help="bb-recomp bundle directory")
+    parser.add_argument("--misses", type=Path, help="Previous AOT misses; add missing guest entry points")
+    parser.add_argument("--options", type=Path, help="Current FEX-validated native patch selections")
+    parser.add_argument("--jobs", type=int, default=3)
+    parser.add_argument("--shards", type=int, default=64)
+    # Shipping Android frontend supports only the one validated build policy.
+    # Older developer TSO variants are not selectable through packaged tools.
+    parser.add_argument("--tso-profile", choices=("off",), default="off",
+                        help="Internal compatibility flag; the only Android AOT build mode")
+    parser.add_argument("--dry-run", action="store_true")
+    args = parser.parse_args(argv)
+    try:
+        game = args.game.resolve(strict=True)
+        # Prefer the merged eboot of the prepared image when an update exists.
+        boot_input = args.boot.resolve(strict=True) if args.boot else None
+        original_game = game
+        game = effective_game_folder(game, boot_input)
+        out = args.out.resolve()
+        if not 1 <= args.jobs <= 16 or not 1 <= args.shards <= 4096:
+            raise ValueError("Invalid --jobs or --shards")
+        for rel in ("eboot.bin", "sce_module/libc.prx", "sce_module/libSceFios2.prx"):
+            check_self(game / rel)
+        version = KNOWN_EBOOTS.get(sha256(game / "eboot.bin"))
+        if not version:
+            raise ValueError("Unverified TLOU executable, refusing AOT translation")
+        if not (game / "sce_sys/param.sfo").is_file() and not args.dry_run:
+            raise ValueError("Missing sce_sys/param.sfo, needed for AOT manifest")
+        out.mkdir(parents=True, exist_ok=True)
+        boot = (boot_input if boot_input else
+                prepare(Path(__file__).resolve().parents[2], game, out / "tlou-prepared"))
+        verified_code_bytes = verify_eboot_image(game / "eboot.bin", boot)
+        digest = sha256(game / "eboot.bin")
+        native_boot = out / "native-boot-linked.bin"
+        native_options = None
+        if args.options is not None:
+            native_options = json.loads(args.options.read_text(encoding="utf-8"))
+            if not isinstance(native_options, dict):
+                raise ValueError("Native patch options must be a JSON object")
+        # Single library, all user-selectable patches compiled as variants.
+        # Do not put any optional visual/resolution byte changes into the
+        # baseline image; otherwise the 'off' version cannot be selected.
+        catalog_mode = version == "1.11" and native_options is not None
+        native_patches = prepare_native_animation_patch(
+            boot, digest, native_boot, native_options, catalog_mode=catalog_mode)
+        variant_info = None
+        if catalog_mode:
+            try:
+                from .patch_variants import create_catalog
+            except ImportError:
+                from patch_variants import create_catalog
+            variant_info = create_catalog(
+                native_boot, digest, out / "aot" / "tlou-111-all-variants.txt")
+        staged = stage_boot(native_boot if native_patches else boot, out / "bb-prepared")
+        aot = out / "aot"
+        aot.mkdir(exist_ok=True)
+        so = aot / "libtlouaot.so"
+        fast_111 = version == "1.11" and native_options is not None and (
+            "invalid-animation-output-pointer" in native_patches and
+            "frame-timeout" in native_patches)
+        cpu_flags = AOT_111_PERFORMANCE_FLAGS if fast_111 else ("-O1",)
+        available_compile_bytes = available_compile_memory_bytes()
+        compile_jobs = select_compile_workers(args.jobs, available_compile_bytes)
+
+        # --tso is a CODE GENERATION option, not a runtime switch.
+        # Fibers and resume-entry safeguards remain enabled in both modes.
+        guest_flags = native_guest_flags(args.tso_profile)
+        command = [str(args.compiler or "/path/to/libbbrecomp.so"),
+                   "--boot", str(staged), "--game-dir", str(game), "--so", str(so),
+                   "--stats", str(aot / "compile.txt"), "--jobs", str(compile_jobs),
+                   "--shards", str(args.shards), "--target", "aarch64",
+                   "--host", "armv8.2", *guest_flags, *cpu_flags, "--no-nice",
+                   "--progress", "--resume"]
+        if args.bundle_dir:
+            command += ["--bundle-dir", str(args.bundle_dir)]
+        if variant_info:
+            command += ["--variants", variant_info["catalog"]]
+            command += ["--variant-report"]
+            if "--no-dirty-check" in command:
+                raise ValueError("Native patch variants require dirty-entry checks")
+        # All 11 entries of the verified 1.11 scheduler switch are seeded at
+        # once. This avoids repeated full recompilation as new cases execute.
+        seed_file = aot / "verified-extra-entries.txt"
+        seed_targets, added_entries = prepare_extra_entries(
+            staged, digest, args.misses, seed_file)
+        granular_file = aot / "granular-risk-functions.txt"
+        granular_hints = prepare_granular_risk_file(
+            staged, digest, args.misses, granular_file)
+        if granular_hints:
+            command += ["--granular-funcs", str(granular_file)]
+        patch_entries = [0xC9FC61] if native_patches else []
+        if patch_entries:
+            added_entries = sorted(set(added_entries + patch_entries))
+            seed_file.write_text(
+                "".join(f"+0x{entry:x}\n" for entry in added_entries),
+                encoding="ascii")
+        if added_entries:
+            command += ["--extra-entries", str(seed_file)]
+        # Verify the emitted native jump table has ALL genuine runtime misses,
+        # not just the switch cases. Percent coverage alone missed this crash.
+        checked_entries = added_entries
+        if checked_entries:
+            command += ["--check-entries",
+                        ",".join(f"{target:x}" for target in checked_entries)]
+        report = {"version": version, "original_game": str(original_game),
+                  "effective_game": str(game), "eboot_sha256": sha256(game / "eboot.bin"),
+                  "input_boot_sha256": sha256(boot), "staged_boot_sha256": sha256(staged),
+                  "native_patch_profile": (
+                      variant_info["profile"] if variant_info
+                      else "tlou-111-animation-guard-v1" if native_patches else ""),
+                  "variant_catalog": variant_info,
+                  "native_patches": native_patches,
+                  "native_patch_options": native_options,
+                  "native_codegen_profile": AOT_111_PERFORMANCE_PROFILE if fast_111 else "conservative-O1",
+                  "native_codegen_flags": list(cpu_flags),
+                  "runtime_code_immutable": not bool(variant_info),
+                  "runtime_patch_contract": (
+                      "native-variants;--no-game-hooks;--patches-at-launch"
+                      if variant_info else "checks-enabled"),
+                  "native_boot_sha256": sha256(native_boot) if native_patches else "",
+                  "native_patch_entries": [f"+0x{x:x}" for x in patch_entries],
+                  "verified_executable_bytes": verified_code_bytes,
+                  "compile_memory_available_mib": available_compile_bytes // (1024 * 1024),
+                  "compile_workers_requested": args.jobs,
+                  "compile_workers_effective": compile_jobs,
+                  "input_boot": check_boot(boot), "translation_command": command,
+                  "runtime_integrated": False, "status": "staged",
+                  "verified_switch_targets": [f"+0x{x:x}" for x in seed_targets],
+                  "extra_entry_count": len(added_entries),
+                  "granular_risk_hint_count": len(granular_hints),
+                  "granular_policy": "verified-indirect-miss-owners-and-callers",
+                  "tso_profile": args.tso_profile,
+                  "guest_memory_model": ("relaxed_ARM64_no_TSO_UNSAFE"
+                                         if args.tso_profile == "off"
+                                         else "conservative_TSO"),
+                  "fiber_resume_entries": True,
+                  "callee_saved_policy": "reload_after_calls_for_fibers",
+                  "x87_mode_warning": "bb-recomp uses reduced precision x87, while TLOU FEX defaults to full; do not execute without compatibility validation"}
+        (out / "aot-report.json").write_text(json.dumps(report, indent=2) + "\n")
+        if args.dry_run:
+            print("Input verified; BBPROBE5 adapter staged. AOT NOT YET COMPILED.")
+            print(" ".join(command))
+            return 0
+        if not args.compiler or not args.compiler.is_file():
+            raise ValueError("Local bb-recomp binary missing; supply --compiler")
+        code = subprocess.run(command, check=False).returncode
+        report["status"] = "compiler_failed"
+        report["exit_code"] = code
+        if code == 0:
+            metadata_file = aot / "libtlouaot.json"
+            if not so.is_file() or not metadata_file.is_file():
+                raise ValueError("Compiler did not write .so and .json")
+            meta = json.loads(metadata_file.read_text())
+            with so.open("rb") as f:
+                elf = f.read(20)
+            if elf[:4] != b"\x7fELF" or struct.unpack_from("<H", elf, 18)[0] != 183:
+                raise ValueError("Output is not AArch64")
+            if meta.get("abi_version") != 2 or meta.get("so_sha256") != sha256(so):
+                raise ValueError("Unexpected AOT ABI or .so hash")
+            report["coverage"] = verify_aot_coverage(aot / "compile.txt", meta)
+            if variant_info:
+                report["variant_build"] = verify_native_variant_coverage(
+                    aot / "compile.txt", variant_info)
+                if int(meta.get("abi_flags", 0)) & 6 != 6:
+                    raise ValueError("Native variant ABI lacks dirty-entry and variant flags")
+            report["status"] = "aarch64_generated_native_ready"
+            report["runtime_integrated"] = True
+            report["unit_count"] = meta.get("unit_count")
+        (out / "aot-report.json").write_text(json.dumps(report, indent=2) + "\n")
+        return code
+    except (OSError, ValueError, subprocess.CalledProcessError) as e:
+        # Persist the actual failure in the exported diagnostic ZIP. Never
+        # accidentally reuse a previously generated .so after quality gates
+        # rejected the newer compiler or an excessive number of trap units.
+        if "report" in locals() and "out" in locals():
+            report["status"] = "validation_failed"
+            report["failure_reason"] = str(e)
+            try:
+                (out / "aot-report.json").write_text(json.dumps(report, indent=2) + "\n")
+            except OSError:
+                pass
+        print(f"TLOU local AOT: {e}", file=sys.stderr)
+        return 1
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/android/aot/bbr_tso_unaligned_helpers.c b/android/aot/bbr_tso_unaligned_helpers.c
new file mode 100644
index 0000000..06d1439
--- /dev/null
+++ b/android/aot/bbr_tso_unaligned_helpers.c
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// TLOU AOT TSO v5: out-of-line *unaligned scalar only* slow path.
+// This is linked into helpers-aarch64.o (no libc dependency beyond builtins).
+// Naturally aligned scalar accesses still execute LLVM Acquire/Release LDAR/STLR.
+#include <stdint.h>
+
+// Fences must not move across the guest memory access or be optimized away.
+// LLVM's original slow path emitted full sequentially consistent fences.
+__attribute__((noinline, cold, visibility("default")))
+uint64_t bbr_tso_unaligned_load(uint64_t address, uint32_t size) {
+    const void *p = (const void *)(uintptr_t)address;
+    uint64_t value = 0;
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    switch (size) {
+        case 2: __builtin_memcpy(&value, p, 2); break;
+        case 4: __builtin_memcpy(&value, p, 4); break;
+        case 8: __builtin_memcpy(&value, p, 8); break;
+        default: __builtin_trap();
+    }
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    return value;
+}
+
+__attribute__((noinline, cold, visibility("default")))
+void bbr_tso_unaligned_store(uint64_t address, uint64_t value, uint32_t size) {
+    void *p = (void *)(uintptr_t)address;
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    switch (size) {
+        case 2: __builtin_memcpy(p, &value, 2); break;
+        case 4: __builtin_memcpy(p, &value, 4); break;
+        case 8: __builtin_memcpy(p, &value, 8); break;
+        default: __builtin_trap();
+    }
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+}
diff --git a/android/aot/bbr_vpcmpistrx.c b/android/aot/bbr_vpcmpistrx.c
new file mode 100644
index 0000000..ef758c1
--- /dev/null
+++ b/android/aot/bbr_vpcmpistrx.c
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: MIT
+ * Portable FEX-style PCMPISTRX intermediate mask and NZCV.
+ * Based on FEX-Emu 2609 VectorFallbacks.h and StringCompareFallbacks.cpp.
+ * x86-64 SSE4.2 hardware reference: 640,000 randomized tests, 0 mismatches.
+ */
+#include <stdint.h>
+#include <string.h>
+
+static int32_t bbr_pcmp_element(const uint8_t* p, uint32_t ctl, int i) {
+    if (ctl & 1) {
+        uint16_t u=(uint16_t)p[2*i] | ((uint16_t)p[2*i+1] << 8);
+        return (ctl & 2) ? (int16_t)u : (int32_t)u;
+    }
+    return (ctl & 2) ? (int8_t)p[i] : (int32_t)p[i];
+}
+static int bbr_pcmp_implicit_length(const uint8_t* p, uint32_t ctl, int n) {
+    int i=0;
+    if (ctl & 1) {
+        for (;i<n;i++) if (p[2*i]==0 && p[2*i+1]==0) break;
+    } else {
+        for (;i<n;i++) if (p[i]==0) break;
+    }
+    return i;
+}
+uint32_t bbr_vpcmpistrx(uint64_t lhs0, uint64_t lhs1, uint64_t rhs0,
+                         uint64_t rhs1, uint32_t control) {
+    uint8_t lhs[16],rhs[16];
+    memcpy(lhs,&lhs0,8);memcpy(lhs+8,&lhs1,8);
+    memcpy(rhs,&rhs0,8);memcpy(rhs+8,&rhs1,8);
+    const uint32_t ctl=control & 0xff;
+    const int n=(ctl & 1)?8:16;
+    const int nl=bbr_pcmp_implicit_length(lhs,ctl,n), nr=bbr_pcmp_implicit_length(rhs,ctl,n);
+    const int mode=(ctl>>2)&3;
+    uint32_t agg=0;
+    if (mode==3 && nl==0) {
+        agg=(1U<<n)-1;
+    } else {
+        for(int j=0;j<n;++j) {
+            int bit=0;
+            if(mode==0){ /* equal any */
+                if(j<nr)for(int i=0;i<nl;i++)
+                    if(bbr_pcmp_element(lhs,ctl,i)==bbr_pcmp_element(rhs,ctl,j)){bit=1;break;}
+            }else if(mode==1){ /* ranges */
+                if(j<nr)for(int i=0;i+1<nl;i+=2){
+                    int v=bbr_pcmp_element(rhs,ctl,j);
+                    if(bbr_pcmp_element(lhs,ctl,i)<=v && v<=bbr_pcmp_element(lhs,ctl,i+1)){bit=1;break;}
+                }
+            }else if(mode==2){ /* equal each, invalid/invalid is true */
+                bit=(j>=nl && j>=nr) ||
+                    (j<nl && j<nr && bbr_pcmp_element(lhs,ctl,j)==bbr_pcmp_element(rhs,ctl,j));
+            }else{ /* equal ordered; full RHS allows partial suffix */
+                if((nr==n || j<=nr-nl)) {
+                    bit=1;
+                    const int lim=((nr-j)<nl ? nr-j : nl);
+                    for(int i=0;i<lim;i++)
+                        if(bbr_pcmp_element(lhs,ctl,i)!=bbr_pcmp_element(rhs,ctl,i+j)){bit=0;break;}
+                }
+            }
+            agg|=(uint32_t)!!bit<<j;
+        }
+    }
+    const unsigned polarity=(ctl>>4)&3;
+    uint32_t mask=agg;
+    if (polarity==1) mask ^= (1U<<n)-1;
+    else if (polarity==3) mask ^= (1U<<nr)-1;
+    uint32_t flags=0;
+    if(nr<n) flags|=4; /* x86 ZF -> ARM Z */
+    if(nl<n) flags|=8; /* x86 SF -> ARM N */
+    if(mask) flags|=2; /* x86 CF -> ARM C */
+    if(mask&1)flags|=1;/* x86 OF -> ARM V */
+    return mask|(flags<<28);
+}
diff --git a/android/aot/build_recompiler_tso.sh b/android/aot/build_recompiler_tso.sh
new file mode 100644
index 0000000..b113293
--- /dev/null
+++ b/android/aot/build_recompiler_tso.sh
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+# Rebuild pinned bb-recomp Android compiler with conservative x86 TSO lowering.
+# Produces only developer tools, never any game data.
+set -Eeuo pipefail
+trap 'echo "TLOU AOT compiler build failed at $LINENO: $BASH_COMMAND" >&2' ERR
+cd "$(dirname "$0")/../.."
+root=$PWD
+pin=6ebb33b0c729a3942fddaa03965360c699d7d900
+tool="$root/.local-deps/bb-recomp-tlou"
+ndk="${ANDROID_NDK_HOME:-${ANDROID_HOME:-/usr/local/lib/android/sdk}/ndk/29.0.14206865}"
+export BB_NDK="$ndk"
+export BB_JOBS="${TLOU_AOT_BUILD_JOBS:-4}"
+export BB_RECOMP_VERSION=1.3.0-tlou-str1
+export BB_X86_DEPS="$tool/.local-deps"
+export BB_FEX_TREE="$tool/out/recomp-fex"
+test -x "$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin/clang"
+mkdir -p "$tool"
+if [[ ! -d "$tool/.git" ]]; then
+  git -C "$tool" init -q
+  git -C "$tool" remote add origin https://github.com/ducvd89/Bloodborne-android-rebuild-tool.git
+fi
+git -C "$tool" fetch --depth=1 origin "$pin"
+git -C "$tool" checkout --detach -f FETCH_HEAD
+test "$(git -C "$tool" rev-parse HEAD)" = "$pin"
+python3 "$root/android/aot/patch_recompiler_tso.py" "$tool"
+python3 "$root/android/aot/patch_recompiler_vpcmpistrx.py" "$tool"
+if [[ ${TLOU_TSO_ALIGNED_AR_EXPERIMENT:-0} == 1 ]]; then
+  python3 "$root/android/aot/patch_recompiler_tso_aligned_ar.py" "$tool"
+fi
+if [[ ${TLOU_TSO_OUTLINE_UNALIGNED_EXPERIMENT:-0} == 1 ]]; then
+  if [[ ${TLOU_TSO_ALIGNED_AR_EXPERIMENT:-0} != 1 ]]; then
+    echo "TSO v5 requires explicit aligned-scalar TSO v4 opt-in" >&2
+    exit 2
+  fi
+  python3 "$root/android/aot/patch_recompiler_tso_outlined.py" "$tool"
+fi
+
+ver=23.1.3
+deps="$tool/.local-deps"
+x86llvm="$deps/llvm/x/LLVM-$ver-Linux-X64"
+llvm_src="$deps/llvm/src/llvm-project-$ver.src"
+download() {
+  local url=$1 path=$2
+  if [[ ! -s $path ]]; then
+    mkdir -p "$(dirname "$path")"
+    curl --fail --location --retry 4 --retry-delay 4 \
+      --connect-timeout 30 "$url" -o "$path.partial"
+    mv "$path.partial" "$path"
+  fi
+}
+if [[ ! -x "$x86llvm/bin/clang" ]]; then
+  x="$deps/llvm/dl/LLVM-$ver-Linux-X64.tar.zst"
+  download "https://github.com/llvm/llvm-project/releases/download/llvmorg-$ver/LLVM-$ver-Linux-X64.tar.zst" "$x"
+  mkdir -p "$deps/llvm/x"
+  (cd "$deps/llvm/x" && zstd -d --long=31 -c "$x" | tar -x)
+fi
+if [[ ! -d "$llvm_src/llvm" ]]; then
+  x="$deps/llvm/dl/llvm-project-$ver.src.tar.xz"
+  download "https://github.com/llvm/llvm-project/releases/download/llvmorg-$ver/llvm-project-$ver.src.tar.xz" "$x"
+  mkdir -p "$deps/llvm/src"
+  tar -xf "$x" -C "$deps/llvm/src"
+fi
+download "https://raw.githubusercontent.com/llvm/llvm-project/llvmorg-$ver/llvm/LICENSE.TXT" "$deps/llvm/LICENSE.TXT"
+download "https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.xz" "$deps/deps/dl/zlib-1.3.1.tar.xz"
+download "https://github.com/facebook/zstd/releases/download/v1.5.7/zstd-1.5.7.tar.gz" "$deps/deps/dl/zstd-1.5.7.tar.gz"
+if [[ ! -f "$deps/mimalloc/mimalloc-3.6.0/src/static.c" ]]; then
+  mkdir -p "$deps/mimalloc"
+  download "https://github.com/microsoft/mimalloc/archive/refs/tags/v3.6.0.tar.gz" "$deps/mimalloc/mimalloc-v3.6.0.tar.gz"
+  tar -xzf "$deps/mimalloc/mimalloc-v3.6.0.tar.gz" -C "$deps/mimalloc"
+fi
+(
+  cd "$tool"
+  bash fetch-fex.sh
+  bash arm64/build.sh android
+  bash arm64/package-android.sh
+)
+compiler="$tool/out/android/libbbrecomp.so"
+tarball="$tool/out/dist/bb-recomp-android-aarch64.tar.xz"
+test -s "$compiler" && test -s "$tarball"
+readelf -h "$compiler" | grep -Eq 'Machine:.*AArch64'
+readelf -l "$compiler" | grep -F '/system/bin/linker64'
+if [[ ${TLOU_TSO_OUTLINE_UNALIGNED_EXPERIMENT:-0} == 1 ]]; then
+  grep -q 'BBR_COMPILER_VERSION "5-tlou-tso-outlined-unaligned-v1"' "$tool/src/version.h"
+  grep -q 'bbr_tso_unaligned_load' "$tool/src/lower_ops.cpp"
+  grep -q 'bbr_tso_unaligned_store' "$tool/src/lower_ops.cpp"
+  grep -q 'uint64_t bbr_tso_unaligned_load' "$tool/helpers/bbr_x87_all.c"
+  grep -q 'void bbr_tso_unaligned_store' "$tool/helpers/bbr_x87_all.c"
+elif [[ ${TLOU_TSO_ALIGNED_AR_EXPERIMENT:-0} == 1 ]]; then
+  grep -q 'BBR_COMPILER_VERSION "4-tlou-tso-aligned-ar-v1"' "$tool/src/version.h"
+  grep -q 'ld->setAtomic(AtomicOrdering::Acquire)' "$tool/src/lower_ops.cpp"
+  grep -q 'st->setAtomic(AtomicOrdering::Release)' "$tool/src/lower_ops.cpp"
+  grep -q 'tso.acquire.unaligned' "$tool/src/lower_ops.cpp"
+  grep -q 'tso.release.unaligned' "$tool/src/lower_ops.cpp"
+else
+  grep -q 'BBR_COMPILER_VERSION "3-tlou-string"' "$tool/src/version.h"
+fi
+grep -q 'case OP_LOADMEMTSO:' "$tool/src/lower_ops.cpp"
+grep -q 'case OP_STOREMEMTSO:' "$tool/src/lower_ops.cpp"
+grep -q 'case OP_VPCMPISTRX:' "$tool/src/lower_vector.cpp"
+grep -q 'uint32_t bbr_vpcmpistrx(' "$tool/helpers/bbr_x87_all.c"
+mkdir -p "$root/out/android-bionic/aot-tso-compiler"
+cp "$tarball" "$root/out/android-bionic/aot-tso-compiler/"
+(cd "$root/out/android-bionic/aot-tso-compiler" && sha256sum bb-recomp-android-aarch64.tar.xz > bb-recomp-android-aarch64.tar.xz.sha256)
+printf '%s\n' "Upstream bb-recomp: $pin" \
+  "Compiler shard version: $(grep BBR_COMPILER_VERSION "$tool/src/version.h")" \
+  "TSO lowering: $(if [[ ${TLOU_TSO_OUTLINE_UNALIGNED_EXPERIMENT:-0} == 1 ]]; then printf 'EXPERIMENTAL v5 aligned scalar LDAR/STLR, rare unaligned full DMB helpers'; elif [[ ${TLOU_TSO_ALIGNED_AR_EXPERIMENT:-0} == 1 ]]; then printf 'EXPERIMENTAL v4 aligned scalar LDAR/STLR, strict SIMD/unaligned fallback'; else printf 'conservative full fences'; fi)" \
+  "Support: GPR up to 64-bit / FPR up to 128-bit; SSE4.2 PCMPISTRX helper bundled" \
+  "No game files included" > "$root/out/android-bionic/aot-tso-compiler/README-TLOU-TSO.txt"
+echo "Finished patched AArch64 compiler archive: $tarball"
diff --git a/android/aot/patch_recompiler_tso.py b/android/aot/patch_recompiler_tso.py
new file mode 100644
index 0000000..643dbce
--- /dev/null
+++ b/android/aot/patch_recompiler_tso.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Add conservative x86-TSO memory lowering to pinned bb-recomp 1.3.0.
+
+The upstream compiler accepts --tso and the FEX decoder emits OP_LOADMEMTSO
+and OP_STOREMEMTSO, but the LLVM backend lacks these cases, silently marking
+most native units dirty with bbr_trap. Do not paper over these ops by disabling
+TSO or replacing their memory semantics with relaxed loads/stores.
+
+This prototype emits full sequentially consistent fences on both sides of the
+guest access. That is conservative and intentionally slower; after gameplay
+correctness is established, we can optimize with per-size acquire/release
+instructions and compare outcomes to FEX on real PS4 code.
+"""
+from __future__ import annotations
+import argparse
+from pathlib import Path
+
+BEFORE = """  case OP_LOADMEM: {
+    auto* o = op->C<IROp_LoadMem>();
+    def(node, loadVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale), size, o->Class == RegClass::FPR));
+    return true;
+  }
+  case OP_STOREMEM: {
+    auto* o = op->C<IROp_StoreMem>();
+    storeVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale), A(o->Value), size, o->Class == RegClass::FPR);
+    return true;
+  }"""
+
+AFTER = """  case OP_LOADMEM: {
+    auto* o = op->C<IROp_LoadMem>();
+    def(node, loadVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale), size, o->Class == RegClass::FPR));
+    return true;
+  }
+  case OP_LOADMEMTSO: {
+    auto* o = op->C<IROp_LoadMemTSO>();
+    // Preserve x86 TSO ordering including Store->Load. An ordinary load is
+    // insufficient on ARM and using LLVM atomic acquire with Align(1) on an
+    // unaligned PS4 pointer would violate the atomic alignment contract.
+    // Strong fences cover all integer and SIMD accesses conservatively.
+    if (size > (o->Class == RegClass::FPR ? 16u : 8u))
+      return false; // genuinely unsupported width: retain explicit dirty trap
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    Value* value = loadVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale),
+                           size, o->Class == RegClass::FPR);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    def(node, value);
+    return true;
+  }
+  case OP_STOREMEM: {
+    auto* o = op->C<IROp_StoreMem>();
+    storeVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale), A(o->Value), size, o->Class == RegClass::FPR);
+    return true;
+  }
+  case OP_STOREMEMTSO: {
+    auto* o = op->C<IROp_StoreMemTSO>();
+    if (size > (o->Class == RegClass::FPR ? 16u : 8u))
+      return false;
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    storeVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale),
+             A(o->Value), size, o->Class == RegClass::FPR);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    return true;
+  }"""
+
+
+def patch(root: Path) -> Path:
+    file = root / "src/lower_ops.cpp"
+    data = file.read_text(encoding="utf-8")
+    if data.count(BEFORE) != 1:
+        if data.count(AFTER) == 1:
+            print("Conservative TSO lowering already installed")
+            return file
+        raise RuntimeError("Upstream changed: refusing to patch LLVM lowering by guesswork")
+    file.write_text(data.replace(BEFORE, AFTER), encoding="utf-8")
+    # The original 1.3.0 tool uses compiler-version 1 for resume/shard keys.
+    # The memory lowering fix changes generated code, so invalidate all old
+    # shards even when the image and command-line inputs are identical.
+    version = root / "src/version.h"
+    version_text = version.read_text(encoding="utf-8")
+    old = '#define BBR_COMPILER_VERSION "1"'
+    if version_text.count(old) != 1:
+        raise RuntimeError("Cannot safely bump bb-recomp compiler shard version")
+    version.write_text(version_text.replace(
+        old, '#define BBR_COMPILER_VERSION "2-tlou-tso"'), encoding="utf-8")
+    assert file.read_text().count("case OP_LOADMEMTSO:") == 1
+    assert file.read_text().count("case OP_STOREMEMTSO:") == 1
+    print("Conservative ARM64 TSO lowering patched: scalar and SIMD <=128 bits")
+    return file
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("upstream", type=Path)
+    a = ap.parse_args()
+    patch(a.upstream)
diff --git a/android/aot/patch_recompiler_tso_aligned_ar.py b/android/aot/patch_recompiler_tso_aligned_ar.py
new file mode 100644
index 0000000..7b12609
--- /dev/null
+++ b/android/aot/patch_recompiler_tso_aligned_ar.py
@@ -0,0 +1,145 @@
+#!/usr/bin/env python3
+"""Opt-in AOT TSO scalar lowering, keeping old full-fence fallback for unaligned/SIMD.
+
+Only naturally-aligned GPR 8/16/32/64-bit accesses use LLVM acquire/release
+atomic loads/stores; this emits LDAR/STLR on ARMv8.0+. Unaligned accesses,
+all SIMD/FPR accesses and unusual sizes retain the original double DMB
+implementation. This is a controlled compiler experiment, NOT a claim of
+whole-game or multicore correctness.
+"""
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+from patch_recompiler_tso import AFTER
+
+OLD_VERSION = '#define BBR_COMPILER_VERSION "3-tlou-string"'
+NEW_VERSION = '#define BBR_COMPILER_VERSION "4-tlou-tso-aligned-ar-v1"'
+
+# Exact v3 lowering is retained verbatim as the conservative fallback.
+OLD_LOAD = "  case OP_LOADMEMTSO: {" + AFTER.split("  case OP_LOADMEMTSO: {", 1)[1].split("  case OP_STOREMEM: {", 1)[0]
+OLD_STORE = "  case OP_STOREMEMTSO: {" + AFTER.split("  case OP_STOREMEMTSO: {", 1)[1]
+
+NEW_LOAD = """  case OP_LOADMEMTSO: {
+    auto* o = op->C<IROp_LoadMemTSO>();
+    if (size > (o->Class == RegClass::FPR ? 16u : 8u))
+      return false;
+    // Preserve the exact two-fence lowering for SIMD and all sizes not
+    // supported by natural scalar ARM64 acquire loads.
+    if (o->Class == RegClass::FPR ||
+        (size != 1 && size != 2 && size != 4 && size != 8)) {
+      B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+      Value* value = loadVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale),
+                             size, o->Class == RegClass::FPR);
+      B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+      def(node, value);
+      return true;
+    }
+    Value* addr = memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale);
+    Value* ptr = B.CreateIntToPtr(addr, Ptr);
+    auto acquire = [&]() -> Value* {
+      auto* ld = B.CreateAlignedLoad(iN(size * 8), ptr, Align(size));
+      ld->setAtomic(AtomicOrdering::Acquire);
+      // Match the original volatile spin-loop policy (atomics also prevent
+      // repeated guest loads from being hoisted out of polling loops).
+      ld->setVolatile(quietLoop.count(curBlock) != 0);
+      return zx(ld);
+    };
+    if (size == 1) {
+      def(node, acquire());
+      return true;
+    }
+    // A guest x86 address can be unaligned. LLVM atomics MUST NOT be marked
+    // naturally aligned unless the runtime address has been checked.
+    Value* naturally_aligned = B.CreateICmpEQ(
+        B.CreateAnd(addr, c64(size - 1)), c64(0));
+    auto* aligned_bb = BasicBlock::Create(B.getContext(), "tso.acquire.aligned", B.GetInsertBlock()->getParent());
+    auto* fallback_bb = BasicBlock::Create(B.getContext(), "tso.acquire.unaligned", B.GetInsertBlock()->getParent());
+    auto* join_bb = BasicBlock::Create(B.getContext(), "tso.acquire.join", B.GetInsertBlock()->getParent());
+    B.CreateCondBr(naturally_aligned, aligned_bb, fallback_bb);
+    B.SetInsertPoint(aligned_bb);
+    Value* aligned_value = acquire();
+    B.CreateBr(join_bb);
+    B.SetInsertPoint(fallback_bb);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    Value* fallback_value = loadVal(addr, size, false);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    B.CreateBr(join_bb);
+    B.SetInsertPoint(join_bb);
+    auto* result = B.CreatePHI(I64, 2);
+    result->addIncoming(aligned_value, aligned_bb);
+    result->addIncoming(fallback_value, fallback_bb);
+    def(node, result);
+    return true;
+  }
+"""
+
+NEW_STORE = """  case OP_STOREMEMTSO: {
+    auto* o = op->C<IROp_StoreMemTSO>();
+    if (size > (o->Class == RegClass::FPR ? 16u : 8u))
+      return false;
+    if (o->Class == RegClass::FPR ||
+        (size != 1 && size != 2 && size != 4 && size != 8)) {
+      B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+      storeVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale),
+               A(o->Value), size, o->Class == RegClass::FPR);
+      B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+      return true;
+    }
+    Value* addr = memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale);
+    Value* ptr = B.CreateIntToPtr(addr, Ptr);
+    auto release = [&]() {
+      auto* st = B.CreateAlignedStore(tr(A(o->Value), size * 8), ptr, Align(size));
+      st->setAtomic(AtomicOrdering::Release);
+    };
+    if (size == 1) {
+      release();
+      return true;
+    }
+    Value* naturally_aligned = B.CreateICmpEQ(
+        B.CreateAnd(addr, c64(size - 1)), c64(0));
+    auto* aligned_bb = BasicBlock::Create(B.getContext(), "tso.release.aligned", B.GetInsertBlock()->getParent());
+    auto* fallback_bb = BasicBlock::Create(B.getContext(), "tso.release.unaligned", B.GetInsertBlock()->getParent());
+    auto* join_bb = BasicBlock::Create(B.getContext(), "tso.release.join", B.GetInsertBlock()->getParent());
+    B.CreateCondBr(naturally_aligned, aligned_bb, fallback_bb);
+    B.SetInsertPoint(aligned_bb);
+    release();
+    B.CreateBr(join_bb);
+    B.SetInsertPoint(fallback_bb);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    storeVal(addr, A(o->Value), size, false);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    B.CreateBr(join_bb);
+    B.SetInsertPoint(join_bb);
+    return true;
+  }"""
+
+
+def patch(upstream: Path) -> None:
+    code_path = upstream / "src/lower_ops.cpp"
+    version_path = upstream / "src/version.h"
+    code = code_path.read_text(encoding="utf-8")
+    version = version_path.read_text(encoding="utf-8")
+    if (NEW_LOAD in code and NEW_STORE in code and NEW_VERSION in version):
+        print("TLOU aligned acquire/release experiment already applied")
+        return
+    if (code.count(OLD_LOAD) != 1 or code.count(OLD_STORE) != 1 or
+        version.count(OLD_VERSION) != 1 or
+        code.count("case OP_LOADMEMTSO:") != 1 or
+        code.count("case OP_STOREMEMTSO:") != 1):
+        raise RuntimeError("Unknown compiler source or shard version; no patch applied")
+    modified = code.replace(OLD_LOAD, NEW_LOAD).replace(OLD_STORE, NEW_STORE)
+    assert modified.count("case OP_LOADMEMTSO:") == 1
+    assert modified.count("case OP_STOREMEMTSO:") == 1
+    assert modified.count("AtomicOrdering::Acquire") >= 1
+    assert modified.count("AtomicOrdering::Release") >= 1
+    # Only change files after EVERY precondition succeeds.
+    version_path.write_text(version.replace(OLD_VERSION, NEW_VERSION), encoding="utf-8")
+    code_path.write_text(modified, encoding="utf-8")
+    print("TLOU opt-in aligned TSO acquire/release compiled-source patch; v4 shards required")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("upstream", type=Path)
+    patch(parser.parse_args().upstream)
diff --git a/android/aot/patch_recompiler_tso_one_fence.py b/android/aot/patch_recompiler_tso_one_fence.py
new file mode 100644
index 0000000..de592f1
--- /dev/null
+++ b/android/aot/patch_recompiler_tso_one_fence.py
@@ -0,0 +1,54 @@
+#!/usr/bin/env python3
+"""EXPERIMENT ONLY: opt-in TLOU AOT x86-TSO one-fence lowering.
+
+NOT production-ready: confirm correctness with ARM64 litmus tests and matched
+FEX/AOT gameplay before using for any APK. The original compiler is unchanged.
+The candidate mapping places dmb ish AFTER guest loads and BEFORE guest stores;
+this preserves the ordered Load->Load, Load->Store and Store->Store pairs while
+allowing the Store->Load relaxation defined by x86-TSO. This is a hypothesis,
+not a completed architecture-level equivalence proof.
+"""
+from pathlib import Path
+import argparse
+
+ORIGINAL_LOAD = """    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    Value* value = loadVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale),
+                           size, o->Class == RegClass::FPR);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);"""
+OPT_LOAD = """    Value* value = loadVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale),
+                           size, o->Class == RegClass::FPR);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);"""
+ORIGINAL_STORE = """    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    storeVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale),
+             A(o->Value), size, o->Class == RegClass::FPR);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);"""
+OPT_STORE = """    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    storeVal(memAddr(o->Addr, o->Offset, o->OffsetType, o->OffsetScale),
+             A(o->Value), size, o->Class == RegClass::FPR);"""
+OLD_VERSION = '#define BBR_COMPILER_VERSION "3-tlou-string"'
+NEW_VERSION = '#define BBR_COMPILER_VERSION "4-tlou-tso-one-fence"'
+
+def patch(upstream: Path) -> None:
+    code, version = upstream / "src/lower_ops.cpp", upstream / "src/version.h"
+    before, old = code.read_text(encoding="utf-8"), version.read_text(encoding="utf-8")
+    if (before.count(OPT_LOAD) == 1 and before.count(OPT_STORE) == 1 and
+            old.count(NEW_VERSION) == 1):
+        print("Experimental TSO mapping already installed")
+        return
+    if (before.count(ORIGINAL_LOAD) != 1 or before.count(ORIGINAL_STORE) != 1 or
+            old.count(OLD_VERSION) != 1 or
+            before.count("case OP_LOADMEMTSO:") != 1 or
+            before.count("case OP_STOREMEMTSO:") != 1):
+        raise RuntimeError("Unexpected LLVM TSO lowering: compiler left unchanged")
+    after = before.replace(ORIGINAL_LOAD, OPT_LOAD).replace(ORIGINAL_STORE, OPT_STORE)
+    if after.count(OPT_LOAD) != 1 or after.count(OPT_STORE) != 1:
+        raise RuntimeError("Unexpected optimization result: compiler left unchanged")
+    # v4 invalidates ALL old --resume shards; there must be no mixing with v3.
+    code.write_text(after, encoding="utf-8")
+    version.write_text(old.replace(OLD_VERSION, NEW_VERSION), encoding="utf-8")
+    print("One-fence candidate installed. No binary or APK built.")
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("upstream", type=Path)
+    patch(ap.parse_args().upstream)
diff --git a/android/aot/patch_recompiler_tso_outlined.py b/android/aot/patch_recompiler_tso_outlined.py
new file mode 100644
index 0000000..c5befb0
--- /dev/null
+++ b/android/aot/patch_recompiler_tso_outlined.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Opt-in AOT TSO v5: put rare unaligned full-fence scalar accesses in shared helpers.
+
+The v4 runtime-guarded LDAR/STLR emits inlined DMB/LDR/DMB and
+DMB/STR/DMB fallback for every dynamic scalar memory op; TLOU 1.11's
+native .text grew from 75.58 to 94.53 MB with no measurable FPS gain.
+
+v5 leaves all aligned LDAR/STLR logic and SIMD conservative lowering
+unchanged, but replaces the unaligned fallback body with two shared
+non-LTO helper calls, preserving the two DMB barriers and exact byte
+size. ONLY active after the complete v4 patch and an explicit build flag.
+
+Not a proof of TSO semantics or of full-game FPS.
+"""
+import argparse
+from pathlib import Path
+from patch_recompiler_tso_aligned_ar import NEW_LOAD as V4_LOAD, NEW_STORE as V4_STORE, NEW_VERSION as V4_VERSION
+
+V5_VERSION = '#define BBR_COMPILER_VERSION "5-tlou-tso-outlined-unaligned-v1"'
+SRC_LOAD = """    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    Value* fallback_value = loadVal(addr, size, false);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);"""
+DST_LOAD = """    Value* fallback_value = B.CreateCall(
+        m.helper("bbr_tso_unaligned_load", I64, {I64, I32}),
+        {addr, c32(size)});"""
+SRC_STORE = """    B.CreateFence(AtomicOrdering::SequentiallyConsistent);
+    storeVal(addr, A(o->Value), size, false);
+    B.CreateFence(AtomicOrdering::SequentiallyConsistent);"""
+DST_STORE = """    B.CreateCall(
+        m.helper("bbr_tso_unaligned_store", m.Void, {I64, I64, I32}),
+        {addr, A(o->Value), c32(size)});"""
+V5_LOAD = V4_LOAD.replace(SRC_LOAD, DST_LOAD)
+V5_STORE = V4_STORE.replace(SRC_STORE, DST_STORE)
+
+def patch(upstream: Path, helpers: Path) -> None:
+    code_path = upstream / "src/lower_ops.cpp"
+    version_path = upstream / "src/version.h"
+    runtime_helpers = upstream / "helpers/bbr_x87_all.c"
+    original = code_path.read_text(encoding="utf-8")
+    version = version_path.read_text(encoding="utf-8")
+    old_helpers = runtime_helpers.read_text(encoding="utf-8")
+    source = helpers.read_text(encoding="utf-8")
+    if (V5_LOAD in original and V5_STORE in original and V5_VERSION in version and
+            "uint64_t bbr_tso_unaligned_load(" in old_helpers):
+        print("TSO v5 outlined fallback already applied")
+        return
+    if (V4_LOAD not in original or V4_STORE not in original or
+            version.count(V4_VERSION) != 1 or
+            original.count("case OP_LOADMEMTSO:") != 1 or
+            original.count("case OP_STOREMEMTSO:") != 1 or
+            original.count(SRC_LOAD) != 1 or original.count(SRC_STORE) != 1 or
+            "uint64_t bbr_tso_unaligned_load(" in old_helpers or
+            "void bbr_tso_unaligned_store(" in old_helpers or
+            source.count("uint64_t bbr_tso_unaligned_load(") != 1 or
+            source.count("void bbr_tso_unaligned_store(") != 1):
+        raise RuntimeError("Unknown v4 compiler or helper source: v5 compiler unchanged")
+    next_code = original.replace(V4_LOAD, V5_LOAD).replace(V4_STORE, V5_STORE)
+    assert next_code.count("case OP_LOADMEMTSO:") == 1
+    assert next_code.count("case OP_STOREMEMTSO:") == 1
+    assert next_code.count("AtomicOrdering::Acquire") >= 1
+    assert next_code.count("AtomicOrdering::Release") >= 1
+    assert next_code.count('m.helper("bbr_tso_unaligned_load"') == 1
+    assert next_code.count('m.helper("bbr_tso_unaligned_store"') == 1
+    runtime_helpers.write_text(old_helpers + "\n" + source)
+    version_path.write_text(version.replace(V4_VERSION, V5_VERSION))
+    code_path.write_text(next_code)
+    print("TSO v5: aligned atomic fast path unchanged; full-fence unaligned fallback outlined")
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("upstream", type=Path)
+    ap.add_argument("--helper-source", type=Path,
+                    default=Path(__file__).with_name("bbr_tso_unaligned_helpers.c"))
+    args=ap.parse_args()
+    patch(args.upstream, args.helper_source)
diff --git a/android/aot/patch_recompiler_vpcmpistrx.py b/android/aot/patch_recompiler_vpcmpistrx.py
new file mode 100644
index 0000000..5df18c9
--- /dev/null
+++ b/android/aot/patch_recompiler_vpcmpistrx.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""Patch bb-recomp 1.3.0 LLVM lowering for PCMPISTRI/M and VEX variants.
+
+The generated ARM64 .so links bbr_vpcmpistrx from the compiler's existing
+helpers-aarch64.o, not from FEX or the Android app. Thus TLOU's libc.prx
+strcmp/strncpy routines can run without a dirty-unit AOT miss.
+"""
+from pathlib import Path
+import argparse
+
+MARK = "  case OP_VEXTRACTTOGPR: {"
+ADD = r'''  case OP_VPCMPISTRX: {
+    // FEX IR's intermediate string-compare mask and NZCV bits. The helper
+    // is inside helpers-aarch64.o so no new runtime dependency is introduced.
+    auto* o = op->C<IROp_VPCMPISTRX>();
+    Value* lhs = A(o->LHS);
+    Value* rhs = A(o->RHS);
+    Value* r = B.CreateCall(
+        m.helper("bbr_vpcmpistrx", I32, {I64, I64, I64, I64, I32}),
+        {B.CreateExtractElement(lhs, uint64_t(0)),
+         B.CreateExtractElement(lhs, uint64_t(1)),
+         B.CreateExtractElement(rhs, uint64_t(0)),
+         B.CreateExtractElement(rhs, uint64_t(1)),
+         c32(uint32_t(o->Control))});
+    def(node, zx(r));
+    return true;
+  }
+'''
+
+
+def patch(upstream: Path, helper_source: Path) -> None:
+    vector = upstream / "src/lower_vector.cpp"
+    s = vector.read_text()
+    if s.count(MARK) != 1:
+        raise ValueError("Unsupported bb-recomp version: missing vector dispatch anchor")
+    if s.count("case OP_VPCMPISTRX:"):
+        raise ValueError("bb-recomp vector compare lowering already exists")
+    vector.write_text(s.replace(MARK, ADD + MARK))
+    helpers = upstream / "helpers/bbr_x87_all.c"
+    original = helpers.read_text()
+    helper = helper_source.read_text()
+    if "uint32_t bbr_vpcmpistrx(" in original:
+        raise ValueError("Duplicate AOT compare helper")
+    if helper.count("uint32_t bbr_vpcmpistrx(") != 1:
+        raise ValueError("Invalid compare helper source")
+    helpers.write_text(original + "\n" + helper)
+    version = upstream / "src/version.h"
+    v = version.read_text()
+    marker = '#define BBR_COMPILER_VERSION "2-tlou-tso"'
+    if v.count(marker) != 1:
+        raise ValueError("The TSO fix must be applied BEFORE the string compare fix")
+    version.write_text(v.replace(marker, '#define BBR_COMPILER_VERSION "3-tlou-string"'))
+    print("AArch64 VPCMPISTRX LLVM lowering and bundled SSE4.2 helper enabled. Shards invalidated (v3).")
+
+
+if __name__ == "__main__":
+    arg = argparse.ArgumentParser()
+    arg.add_argument("upstream", type=Path)
+    arg.add_argument("--helper-source", type=Path,
+                     default=Path(__file__).with_name("bbr_vpcmpistrx.c"))
+    args = arg.parse_args()
+    patch(args.upstream, args.helper_source)
diff --git a/android/aot/patch_variants.py b/android/aot/patch_variants.py
new file mode 100644
index 0000000..9ce74c9
--- /dev/null
+++ b/android/aot/patch_variants.py
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+"""Build every verified TLOU 1.11 patch variant from a *baseline-only* boot.
+
+Uses bb-recomp's native variant catalog (group / w / excl), not a full
+library per combination. The Android game applies its selected BBPATCH2 at
+each launch, and the AOT runtime hashes and selects the affected function
+variant. Data writes need no variant: AOT guest code reads the guest bytes.
+
+This file does not include game instructions or data. No user game assets
+leave the device, and no driver, Vulkan option or TSO flag is changed.
+"""
+import hashlib
+import importlib.util
+from pathlib import Path
+import struct
+
+EFFECTS = ("ssao", "motion_blur", "depth_of_field", "bloom",
+           "sunlight_shadows", "subsurface", "omni_light_shadows",
+           "spot_light_shadows")
+RESOLUTIONS = ("900", "828", "720", "540", "360")
+PROFILE = "tlou-111-variants-v3-odin3"  # Omni/spot classification rerouted, no light discard.
+
+
+def load_patches():
+    path = Path(__file__).resolve().parents[1] / "tlou_patches.py"
+    spec = importlib.util.spec_from_file_location("tlou_variant_patch_definitions", path)
+    if spec is None or spec.loader is None:
+        raise ValueError("Cannot load verified TLOU patch definitions")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def boot_layout(boot: Path):
+    """G3PROBE5/BBPROBE5 segment table. Flag bit 0 means executable."""
+    with boot.open("rb") as source:
+        header = source.read(104)
+        if len(header) != 104:
+            raise ValueError("Truncated linked image")
+        fields = struct.unpack("<8s12Q", header)
+        magic, size, _, ns, nr, ni = fields[:6]
+        mc = fields[-1]
+        if magic not in (b"G3PROBE5", b"BBPROBE5") or not (
+                0 < size <= 512 * 1024 * 1024 and 0 < ns <= 64
+                and mc in (1, 2, 3, 4, 5, 6, 7, 8)):
+            raise ValueError("Unrecognized linked-image layout")
+        source.seek(104 + 56 * mc)
+        nb_raw = source.read(8)
+        if len(nb_raw) != 8:
+            raise ValueError("Truncated binding count")
+        nb = struct.unpack("<Q", nb_raw)[0]
+        if nb > ni:
+            raise ValueError("Invalid binding count")
+        source.seek(104 + 56 * mc + 8 + 24 * nb)
+        segments = []
+        for _ in range(ns):
+            raw = source.read(24)
+            if len(raw) != 24:
+                raise ValueError("Truncated linked-image segments")
+            start, length, flags = struct.unpack("<3Q", raw)
+            if start > size or length > size - start or flags > 7:
+                raise ValueError("Bad linked-image segment")
+            segments.append((start, start + length, bool(flags & 1)))
+        expected_size = 104 + 56*mc + 8 + 24*nb + 24*ns + 128*ni + 32*nr + size
+        if boot.stat().st_size != expected_size:
+            raise ValueError("Linked-image size mismatch")
+        return boot.stat().st_size - size, size, segments
+
+
+def catalog_data(patches, boot_bytes, segments, image_size):
+    """Emit only code variants; always validate *all* optional byte guards."""
+    lines = [
+        "# TLOU 1.11: all verified effects and resolution variants.",
+        "# Runtime applies selected patches.bin; no AOT recompilation on switch.",
+        "# Mutually exclusive resolution choices; independent visual effects.",
+    ]
+    group_names = []
+    code_count = 0
+    data_count = 0
+    ranges = []  # for overlap detection across independent patch groups
+    groups = [("resolution_" + res, "resolution",
+               patches.scene_aim_resolution_patches_111(res))
+              for res in RESOLUTIONS]
+    groups += [("effect_" + effect, "",
+                patches.PERFORMANCE_EFFECTS_111[effect]) for effect in EFFECTS]
+    for group, exclusive, spans in groups:
+        lines.append("group " + group + (" excl=" + exclusive if exclusive else ""))
+        group_names.append(group)
+        group_code = 0
+        for addr, before_hex, after_hex in spans:
+            old = bytes.fromhex(before_hex)
+            if not old or addr < 0 or addr + len(old) > image_size:
+                raise ValueError("Patch outside verified TLOU 1.11 image: " + group)
+            original = boot_bytes(addr, len(old))
+            if original != old:
+                raise ValueError("Original patch guard mismatch in " + group +
+                                 " at +" + hex(addr) + "; refusing AOT")
+            if after_hex is None:
+                continue
+            replacement = bytes.fromhex(after_hex)
+            if len(replacement) != len(old):
+                raise ValueError("Patch changes original code layout: " + group)
+            segment = [item for item in segments
+                       if item[0] <= addr and addr + len(old) <= item[1]]
+            if len(segment) != 1:
+                raise ValueError("Patch straddles linked-image segment: " + group)
+            if not segment[0][2]:
+                # Data constants are written into guest memory at game launch.
+                # No alternate native code is needed for a guest memory load.
+                data_count += 1
+                continue
+            for other_start, other_end, other_group, other_excl in ranges:
+                if addr < other_end and other_start < addr + len(replacement):
+                    if not (exclusive and exclusive == other_excl):
+                        raise ValueError("Overlapping independent patch groups: " +
+                                         group + " / " + other_group)
+            ranges.append((addr, addr + len(replacement), group, exclusive))
+            lines.append(f"w {addr:x} {replacement.hex()}")
+            group_code += 1
+            code_count += 1
+        if not group_code:
+            raise ValueError("Patch option has no compiled code variant: " + group)
+    if len(group_names) != len(EFFECTS) + len(RESOLUTIONS):
+        raise ValueError("Incomplete TLOU patch variant catalog")
+    return "\n".join(lines) + "\n", group_names, code_count, data_count
+
+
+def create_catalog(baseline_boot: Path, eboot_digest: str, destination: Path):
+    patches = load_patches()
+    if eboot_digest not in patches.RESOLUTION_111_SELF_SHA256:
+        raise ValueError("Dynamic 1.11 variants require a SHA-verified executable")
+    start, image_size, segments = boot_layout(baseline_boot)
+    with baseline_boot.open("rb") as f:
+        def read(offset, length):
+            f.seek(start + offset)
+            return f.read(length)
+        catalog, groups, codes, data = catalog_data(patches, read, segments, image_size)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    tmp = destination.with_suffix(".tmp")
+    tmp.write_text(catalog, encoding="ascii")
+    tmp.replace(destination)
+    return {
+        "profile": PROFILE,
+        "sha256": hashlib.sha256(catalog.encode("ascii")).hexdigest(),
+        "groups": groups,
+        "code_writes": codes,
+        "guest_data_writes": data,
+        "catalog": str(destination),
+    }
diff --git a/android/aot/port_runtime.py b/android/aot/port_runtime.py
new file mode 100644
index 0000000..795842b
--- /dev/null
+++ b/android/aot/port_runtime.py
@@ -0,0 +1,575 @@
+#!/usr/bin/env python3
+"""Port Bloodborne's strict AOT CPU ABI to the TLOU runtime.
+
+Upstream: ducvd89/Bloodborne-Android, pinned commit
+b6d4cfb6972c84d4029f54765406ec143df3c30e (GPL-2.0-or-later).
+This derivative adds the PS4 fiber continuation operations required by TLOU.
+It never embeds game code or modifies the player's ELF/SELF.
+"""
+from __future__ import annotations
+import argparse
+from pathlib import Path
+import shutil
+
+UPSTREAM = "b6d4cfb6972c84d4029f54765406ec143df3c30e"
+
+FIBER_API = """
+/* TLOU FEX-compatible guest fiber continuation ABI. */
+#ifndef GUEST_CPU_NATIVE
+typedef struct GuestFiberCpuState GuestFiberCpuState;
+GuestFiberCpuState* guest_cpu_fiber_create(void);
+void guest_cpu_fiber_save(GuestFiberCpuState* state);
+void guest_cpu_fiber_entry(GuestFiberCpuState* state, uintptr_t entry, uintptr_t stack_top,
+                          uint64_t arg0, uint64_t arg1, void* returned, int reset_fpu);
+void guest_cpu_fiber_switch(GuestFiberCpuState* state, void (*release)(void*), void* previous);
+void guest_cpu_fiber_dispose(GuestFiberCpuState* state);
+uint64_t guest_cpu_fiber_frame_pointer(const GuestFiberCpuState* state);
+#endif
+
+"""
+
+GLOBAL_STATE = """
+// TLOU's guest-fiber ABI is an owned snapshot, not a host stack switch.
+// The AOT engine may call C HLE functions which switch PS4 fibers; no AOT
+// unit may continue using the old guest state when the callback returns.
+struct GuestFiberCpuState { GuestState state; };
+
+"""
+PENDING = """
+// Host callbacks can request a fiber change. Apply ONLY after the ARM64
+// callback has returned and the saved x86-64 state is no longer in use.
+thread_local GuestFiberCpuState* tlou_pending_fiber = nullptr;
+thread_local void (*tlou_pending_release)(void*) = nullptr;
+thread_local void* tlou_pending_previous = nullptr;
+
+"""
+HOST_RETURN = """
+    if (tlou_pending_fiber) {
+        GuestFiberCpuState* next = tlou_pending_fiber;
+        auto release = tlou_pending_release;
+        void* previous = tlou_pending_previous;
+        tlou_pending_fiber = nullptr;
+        tlou_pending_release = nullptr;
+        tlou_pending_previous = nullptr;
+        // FS/GS are TLS bases of the EXECUTING OS thread, not fiber-owned
+        // state. A fiber is often prepared by the main thread and later runs
+        // on NdJobWorkerThread N; copying its saved fs/gs would make the worker
+        // read the creator's TLS and return worker-id -1 at guest 0xc89bd0.
+        const uint64_t worker_fs = s->fs_cached;
+        const uint64_t worker_gs = s->gs_cached;
+        const uint64_t saved_fiber_fs = next->state.fs_cached;
+        const uint64_t saved_fiber_gs = next->state.gs_cached;
+        *s = next->state;
+        s->fs_cached = worker_fs;
+        s->gs_cached = worker_gs;
+        // GuestState also contains pointers to its own embedded GDT.
+        s->segment_arrays[0] = s->private_gdt;
+        s->segment_arrays[1] = s->private_gdt;
+        // Sample only initial switches per thread. This proves the fix
+        // without flooding the runtime with hundreds of lines per boot.
+        static thread_local unsigned tlou_tls_switch_samples = 0;
+        if (tlou_tls_switch_samples++ < 3) {
+            std::fprintf(stderr,
+                "TLOU AOT fiber TLS preserved: tid=%ld fiber_fs=%#llx fiber_gs=%#llx thread_fs=%#llx thread_gs=%#llx final_fs=%#llx final_gs=%#llx worker_id=%#llx\\n",
+                (long)syscall(SYS_gettid),
+                (unsigned long long)saved_fiber_fs,
+                (unsigned long long)saved_fiber_gs,
+                (unsigned long long)worker_fs,
+                (unsigned long long)worker_gs,
+                (unsigned long long)s->fs_cached,
+                (unsigned long long)s->gs_cached,
+                (unsigned long long)((worker_gs >= 0x88) ? ReadGuest(worker_gs - 0x88) : 0));
+            std::fflush(stderr);
+        }
+        if (release) release(previous);  // previous fiber can now be reclaimed
+    } else {
+        s->gregs[RSP] = sp + 8;
+        s->rip = ret;
+    }
+"""
+FIBER_IMPL = """
+GuestFiberCpuState* guest_cpu_fiber_create(void) {
+    return new GuestFiberCpuState {};
+}
+void guest_cpu_fiber_save(GuestFiberCpuState* target) {
+    if (!target || !self || !self->depth || !self->host_depth)
+        Fatal("TLOU: fiber save outside a guest->host callback");
+    GuestState& state = *self->s;
+    // AOT HostCall has not yet performed the guest stub's return. Save the
+    // continuation *after* RET, as FEX's guest_cpu_fiber_save does.
+    const uint64_t sp = state.gregs[RSP];
+    target->state = state;
+    target->state.gregs[RSP] = sp + 8;
+    target->state.rip = ReadGuest(sp);
+    target->state.gregs[RAX] = 0;
+    target->state.segment_arrays[0] = target->state.private_gdt;
+    target->state.segment_arrays[1] = target->state.private_gdt;
+}
+void guest_cpu_fiber_entry(GuestFiberCpuState* target, uintptr_t entry,
+                           uintptr_t stack_top, uint64_t arg0, uint64_t arg1,
+                           void* returned, int reset_fpu) {
+    if (!target || !entry || !stack_top || !returned)
+        Fatal("TLOU: invalid guest fiber entry");
+    guest_cpu_fiber_save(target);
+    GuestState& s = target->state;
+    const uintptr_t sp = (stack_top & ~uintptr_t(15)) - 8;
+    *reinterpret_cast<uint64_t*>(sp) = guest_cpu_host_function(returned);
+    s.gregs[RSP] = sp;
+    s.gregs[RBP] = 0;
+    s.gregs[RDI] = arg0;
+    s.gregs[RSI] = arg1;
+    s.gregs[RAX] = 0;
+    s.rip = entry;
+    if (reset_fpu) {
+        s.FCW = 0x037f;
+        s.mxcsr = 0x9fc0;
+    }
+}
+void guest_cpu_fiber_switch(GuestFiberCpuState* target, void (*release)(void*),
+                            void* previous) {
+    if (!target || !self || !self->depth || !self->host_depth)
+        Fatal("TLOU: fiber switch outside guest callback");
+    if (tlou_pending_fiber) Fatal("TLOU: nested fiber switch");
+    tlou_pending_release = release;
+    tlou_pending_previous = previous;
+    tlou_pending_fiber = target;
+}
+void guest_cpu_fiber_dispose(GuestFiberCpuState* target) { delete target; }
+uint64_t guest_cpu_fiber_frame_pointer(const GuestFiberCpuState* target) {
+    return target ? target->state.gregs[RBP] : 0;
+}
+
+"""
+
+
+AOT_HOST_STACK_POLICY = r"""
+// Strict ARM64 units execute x86 calls on the host C++ call stack. The pinned
+// executable allocates only 64 KiB guest + 256 KiB margin = 320 KiB pthread
+// stacks for NdJobWorkerThread/DCLoader. A native unit at +0xca4d40 faulted
+// at a *host-high* page (0x70231e0ff0) with SEGV_ACCERR while working on
+// core. Grow only this known short stack when BB_AOT is enabled; keep FEX,
+// GPU and other Android pthread stack configurations untouched.
+//
+// The pinned probe calls pthread_attr_setstacksize@LIBC through a dynamic
+// relocation. Preloading this AOT engine installs this wrapper without
+// rebuilding or modifying the signed stable runtime executable.
+BBR_EXPORT int pthread_attr_setstacksize(pthread_attr_t* attr, size_t requested) {
+    using Real = int (*)(pthread_attr_t*, size_t);
+    static Real real = reinterpret_cast<Real>(dlsym(RTLD_NEXT, "pthread_attr_setstacksize"));
+    if (!real) return EINVAL;
+    const char* aot = std::getenv("BB_AOT");
+    const bool enabled = aot && *aot && std::strcmp(aot, "0") != 0;
+    constexpr size_t TinyGuestHostStack = (64u + 256u) * 1024u;
+    // Two 2026-11-13 DCLoader SIGSEGVs landed 16/32 bytes inside the
+    // 16 KiB guard after exhausting the previous 2 MiB pthread stack.
+    // 4 MiB is applied ONLY to the exact 320 KiB PS4 guest-thread request
+    // when BB_AOT is active; all FEX, GPU and explicitly sized threads stay unchanged.
+    constexpr size_t SafeAotHostStack = 4u * 1024u * 1024u;
+    const bool adjusted = enabled && requested == TinyGuestHostStack;
+    const size_t actual = adjusted ? SafeAotHostStack : requested;
+    const int result = real(attr, actual);
+    if (adjusted) {
+        static std::atomic<unsigned> reported{0};
+        const unsigned n = reported.fetch_add(1, std::memory_order_relaxed);
+        if (n < 12) {
+            std::fprintf(stderr,
+                "TLOU AOT host pthread stack: requested=%zu applied=%zu error=%d tid=%ld\n",
+                requested, actual, result, (long)syscall(SYS_gettid));
+            std::fflush(stderr);
+        }
+    }
+    return result;
+}
+"""
+
+AOT_SIGNAL_STACK = r"""
+// Native DCLoader workers can use 320 KiB host pthread stacks. A stack
+// overflow may prevent Linux from delivering SIGSEGV to the existing handler,
+// explaining exit 139 without a "TLOU AOT fault entry" line. Register an
+// alternate stack on EACH thread before its first guest execution.
+static thread_local void* tlou_signal_stack = nullptr;
+static constexpr size_t TlouSignalStackSize = 256u * 1024u;
+static thread_local bool tlou_host_stack_sampled = false;
+// Avoid a kernel sigaltstack query and atomic counter on EVERY reentry from HLE.
+// This flag is per-thread and set only after the original signal stack is ready.
+static thread_local bool tlou_signal_stack_ready = false;
+static thread_local uintptr_t tlou_host_stack_low = 0;
+static thread_local uintptr_t tlou_host_stack_high = 0;
+static thread_local size_t tlou_host_stack_guard = 0;
+
+static void TlouEnsureSignalStack() {
+    if (tlou_signal_stack_ready) return;
+    if (!tlou_host_stack_sampled) {
+        tlou_host_stack_sampled = true;
+        pthread_attr_t attributes{};
+        if (pthread_getattr_np(pthread_self(), &attributes) == 0) {
+            void* address = nullptr;
+            size_t length = 0;
+            if (pthread_attr_getstack(&attributes, &address, &length) == 0) {
+                tlou_host_stack_low = reinterpret_cast<uintptr_t>(address);
+                tlou_host_stack_high = tlou_host_stack_low + length;
+            }
+            (void)pthread_attr_getguardsize(&attributes, &tlou_host_stack_guard);
+            pthread_attr_destroy(&attributes);
+        }
+    }
+    stack_t previous{};
+    const int query = sigaltstack(nullptr, &previous);
+    bool signal_stack_active = query == 0 && !(previous.ss_flags & SS_DISABLE);
+    if (query == 0 && (previous.ss_flags & SS_DISABLE)) {
+        void* memory = mmap(nullptr, TlouSignalStackSize,
+                            PROT_READ | PROT_WRITE,
+                            MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (memory != MAP_FAILED) {
+            stack_t alternate{};
+            alternate.ss_sp = memory;
+            alternate.ss_size = TlouSignalStackSize;
+            if (sigaltstack(&alternate, nullptr) == 0) {
+                tlou_signal_stack = memory;
+                signal_stack_active = true;
+            }
+            else
+                munmap(memory, TlouSignalStackSize);
+        }
+    }
+    // src/probe.c registers fault() after guest_cpu_init and before the
+    // first guest_cpu_call. Change its SA_ONSTACK flag, NOT the function.
+    // GPU write-watch faults still flow through the original recovery logic.
+    static std::once_flag once;
+    std::call_once(once, [] {
+        unsigned active = 0;
+        for (int signal : {SIGSEGV, SIGBUS, SIGILL}) {
+            struct sigaction action{};
+            if (sigaction(signal, nullptr, &action) != 0) continue;
+            if (!(action.sa_flags & SA_SIGINFO) || !action.sa_sigaction) continue;
+            if (action.sa_flags & SA_ONSTACK) { ++active; continue; }
+            action.sa_flags |= SA_ONSTACK;
+            if (sigaction(signal, &action, nullptr) == 0) ++active;
+        }
+        std::fprintf(stderr,
+            "TLOU AOT signal handling: SA_ONSTACK=%u/3, existing handler preserved\n",
+            active);
+        std::fflush(stderr);
+    });
+    static std::atomic<unsigned> samples{0};
+    if (samples.fetch_add(1, std::memory_order_relaxed) < 8) {
+        stack_t current{};
+        const int status = sigaltstack(nullptr, &current);
+        std::fprintf(stderr,
+            "TLOU AOT signal altstack: tid=%ld status=%d enabled=%d size=%zu owned=%d\n",
+            (long)syscall(SYS_gettid), status,
+            status == 0 && !(current.ss_flags & SS_DISABLE),
+            status == 0 ? current.ss_size : size_t(0),
+            tlou_signal_stack != nullptr);
+        std::fflush(stderr);
+    }
+    // If mmap/sigaltstack failed, preserve original retry-on-next-entry path.
+    // Never suppress retries or remove the installed GPU fault handler.
+    tlou_signal_stack_ready = signal_stack_active;
+}
+
+static void TlouReleaseSignalStack() {
+    tlou_signal_stack_ready = false;
+    if (!tlou_signal_stack) return;
+    stack_t disabled{};
+    disabled.ss_flags = SS_DISABLE;
+    if (sigaltstack(&disabled, nullptr) == 0)
+        munmap(tlou_signal_stack, TlouSignalStackSize);
+    tlou_signal_stack = nullptr;
+}
+"""
+
+FATAL_SIGNAL_PROBE = r"""
+// Runs first in src/probe.c's existing SIGSEGV/SIGBUS handler, before
+// GPU write-watch recovery. Never replace the renderer's signal handler.
+// Fixed-size stack buffer and write(2), not printf/allocator on a signal.
+static void TlouAotProbeFault(int sig, const siginfo_t* info, const void* uc) {
+    static std::atomic<uint32_t> count{0};
+    const uint32_t n = count.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (n > 48 && n % 128 != 0) return;
+    const uintptr_t pc = bbnative::HostPc(uc);
+    const uint64_t addr = uint64_t(uintptr_t(info ? info->si_addr : nullptr));
+    const Thread* t = self;
+    const uint64_t rip = t && t->s ? t->s->rip : 0;
+    const uint64_t rsp = t && t->s ? t->s->gregs[RSP] : 0;
+    const uintptr_t host_sp = bbnative::HostSp(uc);
+    // si_code=SEGV_ACCERR at the bottom of a small host pthread stack
+    // is distinguishable from an invalid low guest address or GPU page.
+    const bool near_host_stack_guard = tlou_host_stack_low &&
+        addr <= tlou_host_stack_low &&
+        tlou_host_stack_low - addr <= 65536;
+    char line[450];
+    char* out = line;
+    const char* const end = line + sizeof(line) - 1;
+    auto add = [&](const char* word) {
+        for (; *word && out < end; ++word) *out++ = *word;
+    };
+    auto hex = [&](uint64_t value) {
+        static const char digits[] = "0123456789abcdef";
+        if (out + 18 >= end) return;
+        *out++ = '0'; *out++ = 'x';
+        for (unsigned i = 0; i < 16; ++i)
+            *out++ = digits[(value >> ((15-i)*4)) & 15];
+    };
+    add("TLOU AOT fault entry: n="); hex(n);
+    add(" sig="); hex(uint64_t(sig));
+    add(" tid="); hex(uint64_t(syscall(SYS_gettid)));
+    add(" si_code="); hex(uint64_t(info ? info->si_code : 0));
+    add(" fault_addr="); hex(addr);
+    add(" host_pc="); hex(pc);
+    add(" guest_rip="); hex(rip);
+    add(" rsp="); hex(rsp);
+    add(" in_aot="); hex(pc >= E.so_lo && pc < E.so_hi ? 1 : 0);
+    add(" host_sp="); hex(host_sp);
+    add(" host_stack_lo="); hex(tlou_host_stack_low);
+    add(" host_stack_hi="); hex(tlou_host_stack_high);
+    add(" guard_bytes="); hex(tlou_host_stack_guard);
+    add(" near_guard="); hex(near_host_stack_guard ? 1 : 0);
+    *out++ = '\n';
+    (void)write(STDERR_FILENO, line, size_t(out - line));
+}
+"""
+
+WORKER_ENTRY_TRACE = r"""
+    // The 1.11 binary has two distinct job-loop entrypoints: 0xc6a0a0
+    // explicitly registers a numbered worker in TLS, while 0xc6a050 does not.
+    // Do NOT assign an invented ID: record which one runs and its real TLS.
+    if (count == 1 && args &&
+        (fn == E.base + 0xc6a050 || fn == E.base + 0xc6a0a0)) {
+        const uint64_t raw_id = s.gs_cached >= 0x88
+            ? ReadGuest(s.gs_cached - 0x88) : 0;
+        std::fprintf(stderr,
+            "TLOU AOT job thread entry: tid=%ld entry=%#llx arg=%#llx gs=%#llx tls_raw=%#llx\n",
+            (long)syscall(SYS_gettid), (unsigned long long)(fn - E.base),
+            (unsigned long long)args[0], (unsigned long long)s.gs_cached,
+            (unsigned long long)raw_id);
+        std::fflush(stderr);
+    }
+"""
+
+FIBER_RUN_TRACE = r"""
+// At 01.11 x86 offset c82869, StartFiberExecution calls sceFiberRun.
+// c828a3 is a deliberate INT 41 after sceFiberRun returned nonzero.
+// Diagnose the HLE result and fiber state without modifying the call.
+static void TlouTraceFiberRun(const GuestState* s, void* fn, uint64_t ret, bool after) {
+    if (ret != E.base + 0xc8286e) return;
+    const uint64_t fiber = s->gregs[RDI];
+    const uint64_t header = fiber ? ReadGuest(fiber) : 0;
+    const uint64_t entry = fiber ? ReadGuest(fiber + 8) : 0;
+    const uint64_t magic_end = fiber ? ReadGuest(fiber + 0x68) : 0;
+    const uint32_t sig_start = uint32_t(header);
+    const uint32_t state = uint32_t(header >> 32);
+    const uint32_t sig_end = uint32_t(magic_end);
+    std::fprintf(stderr,
+        "TLOU AOT sceFiberRun %s: tid=%ld fn=%p fiber=%#llx magic=%#x/%#x state=%u "
+        "entry=%#llx stack=%#llx size=%#llx incoming=%#llx outgoing=%#llx result=%#x\n",
+        after ? "return" : "enter", (long)syscall(SYS_gettid), fn,
+        (unsigned long long)fiber, sig_start, sig_end, state,
+        (unsigned long long)entry,
+        (unsigned long long)(fiber ? ReadGuest(fiber + 0x18) : 0),
+        (unsigned long long)(fiber ? ReadGuest(fiber + 0x20) : 0),
+        (unsigned long long)s->gregs[RSI],
+        (unsigned long long)s->gregs[RDX],
+        after ? uint32_t(s->gregs[RAX]) : 0u);
+    std::fflush(stderr);
+}
+
+"""
+
+TARGET_PROVENANCE = r"""
+// An all-ones indirect target is NOT the AOT guest return sentinel.
+// Keep the strict failure but report its ARM64 caller and guest registers.
+static void TlouTraceInvalidDispatch(GuestState* s, uint64_t target,
+                                     uintptr_t return_pc, const char* dispatch_kind) {
+    if (target != ~uint64_t{0}) return;
+    uint64_t from_unit = ~uint64_t{0};
+    uintptr_t from_host = 0;
+    auto at = std::upper_bound(E.by_address.begin(), E.by_address.end(), return_pc,
+        [](uintptr_t address, const Engine::Where& w) { return address < w.fn; });
+    if (at != E.by_address.begin()) {
+        --at;
+        from_unit = at->vaddr;
+        from_host = at->fn;
+    }
+    std::fprintf(stderr,
+        "TLOU AOT invalid target: via=%s target=%#llx rip=%#llx arm64_return=%#llx arm64_unit=%#llx guest_unit=%#llx rsp=%#llx rbp=%#llx\n",
+        dispatch_kind, (unsigned long long)target, (unsigned long long)s->rip,
+        (unsigned long long)return_pc, (unsigned long long)from_host,
+        (unsigned long long)from_unit, (unsigned long long)s->gregs[RSP],
+        (unsigned long long)s->gregs[RBP]);
+    // The crashing CALL reads its callback from the job queue. The original
+    // x86-64 code at c88375 reads [scheduler + (worker_id<<7) + 0x780];
+    // print the actual queued values, including the dedicated id=-1 lane.
+    const uint64_t scheduler = ReadGuest(E.base + 0x1aa4780);
+    if (scheduler > 0x10000 && scheduler < (uint64_t{1} << 44)) {
+        std::fprintf(stderr, "TLOU AOT queue state: scheduler=%#llx flag58=%#llx active4f50=%#llx\n",
+            (unsigned long long)scheduler,
+            (unsigned long long)ReadGuest(scheduler + 0x58),
+            (unsigned long long)ReadGuest(scheduler + 0x4f50));
+        for (int idx = -1; idx <= 7; ++idx) {
+            const uint64_t lane = scheduler + 0x780 + intptr_t(idx) * 0x80;
+            std::fprintf(stderr, "TLOU AOT queue lane[%d] addr=%#llx callback=%#llx arg=%#llx\n",
+                idx, (unsigned long long)lane, (unsigned long long)ReadGuest(lane),
+                (unsigned long long)ReadGuest(lane + 8));
+        }
+    }
+    for (unsigned i = 0; i < 16; ++i)
+        std::fprintf(stderr, "TLOU AOT gpr[%02u]=%#llx%s",
+                     i, (unsigned long long)s->gregs[i], i % 4 == 3 ? "\n" : " ");
+    for (unsigned i = 0; i < 8; ++i)
+        std::fprintf(stderr, "TLOU AOT stack[%u] @%#llx = %#llx\n",
+                     i, (unsigned long long)(s->gregs[RSP] + i * 8),
+                     (unsigned long long)ReadGuest(s->gregs[RSP] + i * 8));
+    if (s->gs_cached >= 0x88 && s->gs_cached < (uint64_t{1} << 40)) {
+        std::fprintf(stderr,
+            "TLOU AOT TLS at crash: fs=%#llx gs=%#llx id_slot=%#llx id_value=%#llx\n",
+            (unsigned long long)s->fs_cached, (unsigned long long)s->gs_cached,
+            (unsigned long long)(s->gs_cached - 0x88),
+            (unsigned long long)ReadGuest(s->gs_cached - 0x88));
+    }
+    if (Thread* t = self) {
+        std::fprintf(stderr, "TLOU AOT depth=%u host_depth=%u trace_n=%u\n",
+                     t->depth, t->host_depth, t->trace_n);
+        const unsigned first = t->trace_n > Thread::TraceSize
+            ? t->trace_n - Thread::TraceSize : 0;
+        for (unsigned i = first; i < t->trace_n; ++i) {
+            const auto& e = t->trace[i % Thread::TraceSize];
+            std::fprintf(stderr,
+                "TLOU AOT trace[%u] kind=%u a=%#llx b=%#llx c=%#llx\n",
+                i, e.kind, (unsigned long long)e.a,
+                (unsigned long long)e.b, (unsigned long long)e.c);
+        }
+    }
+    std::fflush(stderr);
+}
+
+"""
+
+def once(source: str, before: str, after: str, name: str) -> str:
+    if source.count(before) != 1:
+        raise ValueError(f"{name}: expected exactly one upstream ABI patch site; found {source.count(before)}")
+    return source.replace(before, after, 1)
+
+
+def port(upstream: Path, out: Path) -> None:
+    cpu = upstream / "cpu"
+    main_header = upstream / "src/guest_cpu.h"
+    required = ("guest_cpu_aot.cpp", "guest_cpu_aot_hooks.inc", "guest_cpu_native.cpp",
+                "guest_cpu_native.h", "guest_cpu_cpuid.h", "guest_cpu_atomics.h",
+                "guest_state.h", "host_call_arm64.S")
+    for name in required:
+        if not (cpu / name).is_file():
+            raise ValueError(f"upstream file missing: {name}")
+    if not main_header.is_file():
+        raise ValueError("Missing upstream guest_cpu.h ABI")
+    out.mkdir(parents=True, exist_ok=True)
+    for name in required:
+        shutil.copy2(cpu / name, out / name)
+    header = main_header.read_text()
+    header = once(header, "#pragma GCC visibility pop", FIBER_API + "#pragma GCC visibility pop",
+                  "fiber ABI declarations")
+    (out / "guest_cpu.h").write_text(header)
+    main = (out / "guest_cpu_aot.cpp").read_text()
+    main = once(main, 'namespace {\nusing namespace bbaot;', AOT_HOST_STACK_POLICY + GLOBAL_STATE + 'namespace {\nusing namespace bbaot;',
+                "global guest fiber state")
+    main = once(main, "thread_local Thread* self;\n", "thread_local Thread* self;\n" + PENDING,
+                "per-thread fiber switch")
+    host_return = "    s->gregs[RSP] = sp + 8;\n    s->rip = ret;\n"
+    main = once(main, host_return, HOST_RETURN, "host callback continuation")
+    main = once(main, 'void guest_cpu_set_panic_text(', FIBER_IMPL + 'void guest_cpu_set_panic_text(',
+                "fiber implementation")
+    # PS4 fibers can resume at the guest address following a CALL. The
+    # --resume-entries units expose that address via GuestState::_pad1.
+    # Bloodborne's strict CPU currently recognizes granular *jump* entries
+    # only. Extend its dispatcher to recognize compiler-provided resume
+    # entries as well, without interpreting arbitrary x86 instructions.
+    main = once(main, "    const uint8_t* flags = nullptr;    // bbr_func_granular[]",
+                "    const uint8_t* flags = nullptr;    // bbr_func_granular[]\n    bool resume = false;       // bbr_abi_flags bit 0",
+                "resume capability")
+    main = once(main, "    if (!G.flags) return false;",
+                "    if (!G.flags && !G.resume) return false;",
+                "resume dispatch prerequisite")
+    main = once(main, "    if (offset >= f->end || !G.flags[f - G.funcs]) return false;",
+                "    if (offset >= f->end || !(G.resume || (G.flags && G.flags[f - G.funcs]))) return false;",
+                "resume range check")
+    original_loader = '''    if (abi_flags && (*abi_flags & 1))
+        std::fprintf(stderr, "AOT: %s has resume entries (bbr_abi_flags bit 0); this runtime does not use them\\n", path);
+    if (abi_flags && (*abi_flags & 16)) {   // granular entries: bbr_func_granular[] says which functions of bbr_funcs[] have them
+        G.funcs = static_cast<const GranRec*>(dlsym(so, "bbr_funcs"));
+        const auto* nf = static_cast<const uint64_t*>(dlsym(so, "bbr_func_count"));
+        G.flags = static_cast<const uint8_t*>(dlsym(so, "bbr_func_granular"));
+        G.nfuncs = nf ? *nf : 0;
+        if (!G.funcs || !G.flags || !G.nfuncs) { G.flags = nullptr; std::fprintf(stderr, "AOT: %s: granular entries declared but their tables are missing\\n", path); }
+    }'''
+    adapted_loader = '''    G.resume = abi_flags && (*abi_flags & 1);
+    if (G.resume || (abi_flags && (*abi_flags & 16))) {
+        G.funcs = static_cast<const GranRec*>(dlsym(so, "bbr_funcs"));
+        const auto* nf = static_cast<const uint64_t*>(dlsym(so, "bbr_func_count"));
+        G.flags = (abi_flags && (*abi_flags & 16))
+            ? static_cast<const uint8_t*>(dlsym(so, "bbr_func_granular")) : nullptr;
+        G.nfuncs = nf ? *nf : 0;
+        if (!G.funcs || !G.nfuncs || ((abi_flags && (*abi_flags & 16)) && !G.flags)) {
+            G.resume = false;
+            G.flags = nullptr;
+            std::fprintf(stderr, "AOT: %s: resume/granular function tables unavailable\\n", path);
+        }
+    }
+    if (G.resume) std::printf("TLOU AOT: guest CALL return sites enabled for PS4 fiber resumes\\n");'''
+    main = once(main, original_loader, adapted_loader, "PS4 fiber resume dispatch")
+    main = once(main, "BBR_EXPORT void bbr_dispatch(GuestState* s, uint64_t target) {",
+                TARGET_PROVENANCE + """BBR_EXPORT void bbr_dispatch(GuestState* s, uint64_t target) {
+    if (target == ~uint64_t{0}) TlouTraceInvalidDispatch(s, target, (uintptr_t)__builtin_return_address(0), "call");""",
+                "invalid indirect call provenance")
+    main = once(main, "BBR_EXPORT void bbr_dispatch_tail(GuestState* s) {\n    const uint64_t target = s->rip;",
+                """BBR_EXPORT void bbr_dispatch_tail(GuestState* s) {
+    const uint64_t target = s->rip;
+    if (target == ~uint64_t{0}) TlouTraceInvalidDispatch(s, target, (uintptr_t)__builtin_return_address(0), "tail");""",
+                "invalid indirect tail provenance")
+    main = once(main, "    s.rip = fn;\n    bbr_dispatch(&s, fn);",
+                "    s.rip = fn;\n" + WORKER_ENTRY_TRACE + "    bbr_dispatch(&s, fn);",
+                "TLOU 1.11 AOT job worker entry provenance")
+    main = once(main,
+                "int guest_cpu_handle_fault(int sig, siginfo_t* info, void* ucontext) {",
+                "int guest_cpu_handle_fault(int sig, siginfo_t* info, void* ucontext) {\n"
+                "    TlouAotProbeFault(sig, info, ucontext);\n",
+                "AOT fault pretrace before GPU recovery")
+    main = once(main,
+                "int guest_cpu_handle_fault(int sig, siginfo_t* info, void* ucontext) {",
+                FATAL_SIGNAL_PROBE + "int guest_cpu_handle_fault(int sig, siginfo_t* info, void* ucontext) {",
+                "AOT fault recorder definition")
+    main = once(main, "uintptr_t guest_cpu_host_function(void* fn) {",
+                AOT_SIGNAL_STACK + "uintptr_t guest_cpu_host_function(void* fn) {",
+                "per-thread alternate signal stack definition")
+    main = once(main,
+                "    Thread* t = Current();\n    GuestState& s = *t->s;",
+                "    Thread* t = Current();\n    TlouEnsureSignalStack();\n    GuestState& s = *t->s;",
+                "register altstack before AOT guest code executes")
+    main = once(main,
+                "void guest_cpu_thread_end(void) {\n    Thread* t = self;",
+                "void guest_cpu_thread_end(void) {\n    TlouReleaseSignalStack();\n    Thread* t = self;",
+                "restore signal stack at thread end")
+    main = once(main,
+                "inline void HostCall(GuestState* s, void* fn, Thread* t) {",
+                FIBER_RUN_TRACE + "inline void HostCall(GuestState* s, void* fn, Thread* t) {",
+                "TLOU sceFiberRun trace helper definition")
+    main = once(main,
+                "    Trace(t, EvHost, reinterpret_cast<uint64_t>(fn), sp, ret);\n",
+                "    Trace(t, EvHost, reinterpret_cast<uint64_t>(fn), sp, ret);\n"
+                "    TlouTraceFiberRun(s, fn, ret, false);\n",
+                "TLOU fiber run HLE entry diagnostics")
+    main = once(main,
+                "    CallHostFn(s, fn);\n    --t->host_depth;\n",
+                "    CallHostFn(s, fn);\n"
+                "    TlouTraceFiberRun(s, fn, ret, true);\n"
+                "    --t->host_depth;\n",
+                "TLOU fiber run HLE return diagnostics")
+    (out / "guest_cpu_aot.cpp").write_text(main)
+    print(f"TLOU AOT backend: upstream {UPSTREAM}, PS4 fiber ABI ported; source generated at {out}")
+
+
+if __name__ == "__main__":
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--upstream", type=Path, required=True)
+    p.add_argument("--out", type=Path, required=True)
+    a = p.parse_args()
+    port(a.upstream, a.out)
