+#include "video_core/renderer_vulkan/tlou_buffer_descriptor_template.h"
+
+VULKAN_HPP_DEFAULT_DISPATCH_LOADER_DYNAMIC_STORAGE
+
+static void Check(VkResult r) { if(r!=VK_SUCCESS) { std::fprintf(stderr,"VkResult=%d\n",r); std::abort(); } }
+#include "tlou_graphics_descriptor_check.h"
+int main(int argc, char** argv) {
+  VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO}; app.apiVersion=VK_API_VERSION_1_1;
+  VkInstanceCreateInfo ici{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO}; ici.pApplicationInfo=&app;
+  VkInstance instance; Check(vkCreateInstance(&ici,nullptr,&instance));
+  uint32_t count=0; Check(vkEnumeratePhysicalDevices(instance,&count,nullptr)); assert(count);
+  std::vector<VkPhysicalDevice> devices(count); Check(vkEnumeratePhysicalDevices(instance,&count,devices.data()));
+  auto physical=devices[0]; VkPhysicalDeviceProperties props; vkGetPhysicalDeviceProperties(physical,&props);
+  uint32_t qcount=0; vkGetPhysicalDeviceQueueFamilyProperties(physical,&qcount,nullptr);
+  std::vector<VkQueueFamilyProperties> queues(qcount); vkGetPhysicalDeviceQueueFamilyProperties(physical,&qcount,queues.data());
+  uint32_t family=0; while(!(queues[family].queueFlags&VK_QUEUE_COMPUTE_BIT)) ++family;
+  float priority=1; VkDeviceQueueCreateInfo qci{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO}; qci.queueFamilyIndex=family; qci.queueCount=1; qci.pQueuePriorities=&priority;
+  const char* ext="VK_KHR_push_descriptor";
+  VkDeviceCreateInfo dci{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO}; dci.queueCreateInfoCount=1;dci.pQueueCreateInfos=&qci;dci.enabledExtensionCount=1;dci.ppEnabledExtensionNames=&ext;
+  VkDevice device; Check(vkCreateDevice(physical,&dci,nullptr,&device));
+  auto push=(PFN_vkCmdPushDescriptorSetKHR)vkGetDeviceProcAddr(device,"vkCmdPushDescriptorSetKHR");
+  auto push_template=(PFN_vkCmdPushDescriptorSetWithTemplateKHR)vkGetDeviceProcAddr(device,"vkCmdPushDescriptorSetWithTemplateKHR"); assert(push&&push_template);
+  VULKAN_HPP_DEFAULT_DISPATCHER.vkCmdPushDescriptorSetWithTemplateKHR=push_template;
+  const auto push_production_template=[&](VkCommandBuffer commands, VkDescriptorUpdateTemplate update,
+                                         VkPipelineLayout layout, const VkDescriptorBufferInfo* buffers, unsigned n) {
+    Vulkan::Detail::PushBufferDescriptorTemplate(vk::CommandBuffer{commands},
+      vk::DescriptorUpdateTemplate{update},vk::PipelineLayout{layout},
+      std::span<const VkDescriptorBufferInfo>{buffers,n});
+  };
+  VkBufferCreateInfo bci{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO}; bci.size=1024*1024;bci.usage=VK_BUFFER_USAGE_STORAGE_BUFFER_BIT|VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+  VkBuffer buffer;Check(vkCreateBuffer(device,&bci,nullptr,&buffer));VkMemoryRequirements mr;vkGetBufferMemoryRequirements(device,buffer,&mr);
+  VkPhysicalDeviceMemoryProperties mp;vkGetPhysicalDeviceMemoryProperties(physical,&mp);
+  unsigned memory_type=0;
+  const auto host_flags=VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT|VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+  while(!(mr.memoryTypeBits&(1u<<memory_type)) || (mp.memoryTypes[memory_type].propertyFlags&host_flags)!=host_flags)++memory_type;
+  VkMemoryAllocateInfo mai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};mai.allocationSize=mr.size;mai.memoryTypeIndex=memory_type;
+  VkDeviceMemory memory;Check(vkAllocateMemory(device,&mai,nullptr,&memory));Check(vkBindBufferMemory(device,buffer,memory,0));
+  void* mapped=nullptr;Check(vkMapMemory(device,memory,0,mr.size,0,&mapped));
+  auto* words=static_cast<uint32_t*>(mapped);
+  VkCommandPoolCreateInfo pci{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};pci.queueFamilyIndex=family;
+  VkCommandPool pool;Check(vkCreateCommandPool(device,&pci,nullptr,&pool));
+  VkCommandBufferAllocateInfo cai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};cai.commandPool=pool;cai.commandBufferCount=1;cai.level=VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+  VkCommandBuffer cmd;Check(vkAllocateCommandBuffers(device,&cai,&cmd));
+  std::printf("DRIVER %s api=%u.%u.%u\n",props.deviceName,VK_VERSION_MAJOR(props.apiVersion),VK_VERSION_MINOR(props.apiVersion),VK_VERSION_PATCH(props.apiVersion));
+  constexpr unsigned Calls=2048;
+  for(unsigned n:{2u,4u,8u,16u}) {
+    std::vector<VkDescriptorSetLayoutBinding> bindings(n);
+    std::vector<VkDescriptorUpdateTemplateEntry> entries(n);
+    std::vector<VkWriteDescriptorSet> writes(n),saved_writes(Calls*n);
+    std::vector<VkDescriptorBufferInfo> infos(n),saved_infos(Calls*n);
+    for(unsigned j=0;j<n;++j) {
+      bindings[j]={j,VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,1,VK_SHADER_STAGE_COMPUTE_BIT,nullptr};
+      entries[j]={j,0,1,VK_DESCRIPTOR_TYPE_STORAGE_BUFFER,j*sizeof(VkDescriptorBufferInfo),sizeof(VkDescriptorBufferInfo)};
+      infos[j]={buffer,j*256u,128};writes[j]={VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+      writes[j].dstBinding=j;writes[j].descriptorCount=1;writes[j].descriptorType=VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;writes[j].pBufferInfo=&infos[j];
+    }
+    VkDescriptorSetLayoutCreateInfo sci{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};sci.flags=VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR;sci.bindingCount=n;sci.pBindings=bindings.data();
+    VkDescriptorSetLayout set;Check(vkCreateDescriptorSetLayout(device,&sci,nullptr,&set));
+    VkPushConstantRange push_range{VK_SHADER_STAGE_COMPUTE_BIT,0,4};
+    VkPipelineLayoutCreateInfo lci{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};lci.setLayoutCount=1;lci.pSetLayouts=&set;lci.pushConstantRangeCount=1;lci.pPushConstantRanges=&push_range;
+    VkPipelineLayout layout;Check(vkCreatePipelineLayout(device,&lci,nullptr,&layout));
+    VkDescriptorUpdateTemplateCreateInfo tci{VK_STRUCTURE_TYPE_DESCRIPTOR_UPDATE_TEMPLATE_CREATE_INFO};tci.descriptorUpdateEntryCount=n;tci.pDescriptorUpdateEntries=entries.data();tci.templateType=VK_DESCRIPTOR_UPDATE_TEMPLATE_TYPE_PUSH_DESCRIPTORS_KHR;tci.pipelineBindPoint=VK_PIPELINE_BIND_POINT_COMPUTE;tci.pipelineLayout=layout;
+    VkDescriptorUpdateTemplate update;Check(vkCreateDescriptorUpdateTemplate(device,&tci,nullptr,&update));
+    // The same production guard is exercised with real Vulkan structures.
+    const auto matches=[&]{return Vulkan::Detail::MatchesBufferDescriptorTemplate(
+      std::span<const VkWriteDescriptorSet>{writes},std::span<const VkDescriptorBufferInfo>{infos},n,VK_DESCRIPTOR_TYPE_STORAGE_BUFFER);};
+    assert(matches()==(n>=4));
+    if(argc>1) {
+      const auto path=std::string(argv[1])+"/buffers-"+std::to_string(n)+".spv";
+      std::ifstream file(path,std::ios::binary|std::ios::ate);assert(file);
+      std::vector<uint32_t> code(static_cast<size_t>(file.tellg())/4);file.seekg(0);file.read(reinterpret_cast<char*>(code.data()),code.size()*4);assert(file);
+      VkShaderModuleCreateInfo smi{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};smi.codeSize=code.size()*4;smi.pCode=code.data();
+      VkShaderModule shader;Check(vkCreateShaderModule(device,&smi,nullptr,&shader));
+      VkComputePipelineCreateInfo pipeline_ci{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};pipeline_ci.layout=layout;
+      pipeline_ci.stage={VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};pipeline_ci.stage.stage=VK_SHADER_STAGE_COMPUTE_BIT;pipeline_ci.stage.module=shader;pipeline_ci.stage.pName="main";
+      VkPipeline pipeline;Check(vkCreateComputePipelines(device,VK_NULL_HANDLE,1,&pipeline_ci,nullptr,&pipeline));
+      VkQueue queue;vkGetDeviceQueue(device,family,0,&queue);
+      for(unsigned j=0;j<n*65536/4;++j)words[j]=j*17u+31u;
+      for(unsigned mode=0;mode<2;++mode) {
+        Check(vkResetCommandPool(device,pool,0));VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};Check(vkBeginCommandBuffer(cmd,&begin));
+        vkCmdBindPipeline(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,pipeline);
+        for(unsigned k=0;k<128;++k) {
+          for(unsigned j=0;j<n;++j)infos[j]={buffer,j*65536u+(j==n-1?mode*16384u:(k%3)*4096u),(k%2?12288u:8192u)};
+          if(mode)push_production_template(cmd,update,layout,infos.data(),n);else push(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,layout,0,n,writes.data());
+          vkCmdPushConstants(cmd,layout,VK_SHADER_STAGE_COMPUTE_BIT,0,4,&k);vkCmdDispatch(cmd,1,1,1);
+        }
+        VkMemoryBarrier host{VK_STRUCTURE_TYPE_MEMORY_BARRIER};host.srcAccessMask=VK_ACCESS_SHADER_WRITE_BIT;host.dstAccessMask=VK_ACCESS_HOST_READ_BIT;
+        vkCmdPipelineBarrier(cmd,VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,VK_PIPELINE_STAGE_HOST_BIT,0,1,&host,0,nullptr,0,nullptr);
+        Check(vkEndCommandBuffer(cmd));VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};submit.commandBufferCount=1;submit.pCommandBuffers=&cmd;Check(vkQueueSubmit(queue,1,&submit,VK_NULL_HANDLE));Check(vkQueueWaitIdle(queue));
+        for(unsigned k=0;k<128;++k) {
+          uint32_t expected=0;for(unsigned j=0;j<n-1;++j)expected+=words[(j*65536+(k%3)*4096)/4+k];
+          assert(words[((n-1)*65536+mode*16384)/4+k]==expected);
+        }
+      }
+      std::printf("GPU EXACT buffers=%u: 128 changing offsets/ranges, legacy/template outputs PASS\n",n);
+      vkDestroyPipeline(device,pipeline,nullptr);vkDestroyShaderModule(device,shader,nullptr);
+    }
+    if(argc<=2) {
+    std::array<std::vector<double>,2> producer,consumer;
+    for(unsigned round=0;round<42;++round) for(unsigned pass=0;pass<2;++pass) {
+      const unsigned mode=pass^(round&1);
+      auto start=std::chrono::steady_clock::now();
+      for(unsigned k=0;k<Calls;++k) {
+        infos[0].offset=(k%128)*256;
+        auto* dst=saved_infos.data()+k*n;
+        if(mode) {
+          if(n>=4 && !matches())std::abort();
+          std::memcpy(dst,infos.data(),n*sizeof(*dst));
+        }
+        else {
+          auto* ws=saved_writes.data()+k*n;std::memcpy(ws,writes.data(),n*sizeof(*ws));
+          for(unsigned j=0;j<n;++j) {dst[j]=*ws[j].pBufferInfo;ws[j].pBufferInfo=&dst[j];}
+        }
+      }
+      auto middle=std::chrono::steady_clock::now();
+      Check(vkResetCommandPool(device,pool,0));VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};Check(vkBeginCommandBuffer(cmd,&begin));
+      for(unsigned k=0;k<Calls;++k) {
+        if(mode)push_production_template(cmd,update,layout,saved_infos.data()+k*n,n);
+        else push(cmd,VK_PIPELINE_BIND_POINT_COMPUTE,layout,0,n,saved_writes.data()+k*n);
+      }
+      Check(vkEndCommandBuffer(cmd)); auto end=std::chrono::steady_clock::now();
+      if(round>1){producer[mode].push_back(std::chrono::duration<double,std::nano>(middle-start).count()/Calls);consumer[mode].push_back(std::chrono::duration<double,std::nano>(end-middle).count()/Calls);}
+    }
+    for(auto& v:producer)std::sort(v.begin(),v.end());
+    for(auto& v:consumer)std::sort(v.begin(),v.end());
+    std::printf("buffers=%u old_snapshot=%.1f template_snapshot=%.1f old_driver=%.1f template_driver=%.1f ns/call; saved_data=%zu bytes/call\n",n,producer[0][20],producer[1][20],consumer[0][20],consumer[1][20],n*sizeof(VkWriteDescriptorSet));
+    // A candidate without a substantial gain must not release an APK. Gate
+    // only the large case to avoid noise around the small-call crossover.
+    if(n==16) assert(producer[1][20]+consumer[1][20] < 0.95*(producer[0][20]+consumer[0][20]));
+    }
+    vkDestroyDescriptorUpdateTemplate(device,update,nullptr);vkDestroyPipelineLayout(device,layout,nullptr);vkDestroyDescriptorSetLayout(device,set,nullptr);
+    if(argc>1)CheckGraphicsDescriptors(device,physical,buffer,words,pool,cmd,argv[1],n,argc<=2);
+  }
+  vkDestroyCommandPool(device,pool,nullptr);vkUnmapMemory(device,memory);vkDestroyBuffer(device,buffer,nullptr);vkFreeMemory(device,memory,nullptr);vkDestroyDevice(device,nullptr);vkDestroyInstance(instance,nullptr);
+}
diff --git a/gow3_pc/tests/test_tlou_host_copy_wait.cpp b/gow3_pc/tests/test_tlou_host_copy_wait.cpp
new file mode 100644
index 0000000..5df24ee
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_host_copy_wait.cpp
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "../gpu/shadps4/video_core/renderer_vulkan/tlou_host_copy_wait.h"
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <thread>
+#include <time.h>
+
+using namespace std::chrono_literals;
+static double ThreadCpuMs() {
+    timespec ts{};
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
+    return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
+}
+
+int main() {
+    std::atomic<std::uint64_t> done{5};
+    Vulkan::Detail::WaitForHostCopySequence(done, 5); // already completed
+    // A recorder batch can publish several intermediate copy sequences at once.
+    std::atomic<unsigned> arrivals{0};
+    std::thread first([&] {
+        arrivals.fetch_add(1);
+        Vulkan::Detail::WaitForHostCopySequence(done, 10);
+    });
+    std::thread second([&] {
+        arrivals.fetch_add(1);
+        Vulkan::Detail::WaitForHostCopySequence(done, 12);
+    });
+    while (arrivals.load() != 2) std::this_thread::yield();
+    done.store(11, std::memory_order_release);
+    done.notify_all();
+    done.store(12, std::memory_order_release);
+    done.notify_all();
+    first.join();
+    second.join();
+
+    std::atomic<std::uint64_t> sequence{0}, request{0};
+    constexpr int N = 1200;
+    std::thread recorder([&] {
+        for (int i = 1; i <= N; ++i) {
+            while (request.load(std::memory_order_acquire) <
+                   static_cast<std::uint64_t>(i)) std::this_thread::yield();
+            std::this_thread::sleep_for(80us);
+            sequence.store(i, std::memory_order_release);
+            sequence.notify_all();
+        }
+    });
+    const double cpu_begin = ThreadCpuMs();
+    const auto wall_begin = std::chrono::steady_clock::now();
+    for (int i = 1; i <= N; ++i) {
+        request.store(i, std::memory_order_release);
+        Vulkan::Detail::WaitForHostCopySequence(sequence, i);
+        assert(sequence.load(std::memory_order_acquire) >=
+               static_cast<std::uint64_t>(i));
+    }
+    const double cpu_ms = ThreadCpuMs() - cpu_begin;
+    const double wall_ms = std::chrono::duration<double, std::milli>(
+        std::chrono::steady_clock::now() - wall_begin).count();
+    recorder.join();
+    std::printf("TLOU host-copy waits: %d sequences, CPU %.3f ms / wall %.3f ms, correctness OK\\n",
+                N, cpu_ms, wall_ms);
+}
diff --git a/gow3_pc/tests/test_tlou_native_pid_publish.c b/gow3_pc/tests/test_tlou_native_pid_publish.c
new file mode 100644
index 0000000..7516446
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_native_pid_publish.c
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#define _GNU_SOURCE
+#include "../src/android_cpu_policy.h"
+#include <assert.h>
+#include <sys/types.h>
+
+int main(void) {
+    char path[] = "/tmp/tlou-native-pid-XXXXXX";
+    const int fd = mkstemp(path);
+    assert(fd >= 0);
+    close(fd);
+    assert(setenv("TLOU_NATIVE_PID_FILE", path, 1) == 0);
+
+    // Native publication must replace any stale wrapper PID.
+    FILE *file = fopen(path, "w");
+    assert(file != NULL);
+    assert(fputs("1\n", file) >= 0);
+    assert(fclose(file) == 0);
+    tlou_cpu_publish_native_pid();
+
+    file = fopen(path, "r");
+    assert(file != NULL);
+    long published = -1;
+    assert(fscanf(file, "%ld", &published) == 1);
+    assert(fclose(file) == 0);
+    assert(published == (long)getpid());
+
+    // No env variable: do not create or modify any file.
+    assert(unsetenv("TLOU_NATIVE_PID_FILE") == 0);
+    tlou_cpu_publish_native_pid();
+    file = fopen(path, "r");
+    assert(file != NULL);
+    long unchanged = -1;
+    assert(fscanf(file, "%ld", &unchanged) == 1);
+    assert(fclose(file) == 0);
+    assert(unchanged == (long)getpid());
+    assert(unlink(path) == 0);
+    puts("TLOU native PID publication tests passed");
+    return 0;
+}
diff --git a/gow3_pc/tests/test_tlou_qualcomm_float_compat.cpp b/gow3_pc/tests/test_tlou_qualcomm_float_compat.cpp
new file mode 100644
index 0000000..2497247
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_qualcomm_float_compat.cpp
@@ -0,0 +1,62 @@
+// Standalone unit tests; no Vulkan SDK or device needed.
+#include "../gpu/shadps4/video_core/renderer_vulkan/vk_qualcomm_float_compat.h"
+#include <algorithm>
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+using Vulkan::QualcommFloatCompat::DropExplicitFloatControls;
+using Words = std::vector<uint32_t>;
+static void Add(Words& v, uint32_t op, std::initializer_list<uint32_t> args) {
+    v.push_back((uint32_t(args.size() + 1) << 16) | op);
+    v.insert(v.end(), args.begin(), args.end());
+}
+static void AddFloatExtension(Words& v) {
+    constexpr char text[] = "SPV_KHR_float_controls";
+    constexpr size_t words = (sizeof(text) + 3) / 4;
+    uint32_t body[words]{};
+    std::memcpy(body, text, sizeof(text));
+    v.push_back(uint32_t((words + 1) << 16) | 10);
+    v.insert(v.end(), body, body + words);
+}
+static bool Has(const Words& v, uint32_t op, uint32_t arg) {
+    for(size_t i = 5; i < v.size();) {
+        const uint32_t n = v[i] >> 16;
+        if (!n || n > v.size()-i) return false;
+        if ((v[i] & 0xffff) == op && n >= 2 && v[i+1] == arg) return true;
+        i += n;
+    }
+    return false;
+}
+int main() {
+    // Exact capability/execution-mode instruction pattern of ZIP32 compute
+    // shader 0x4a705408; preserve workgroup=32x32x1 and Image1D capability.
+    Words src={0x07230203,0x00010600,0,0xd7,0};
+    Add(src,17,{1});
+    Add(src,17,{44});       // Image1D; do not remove
+    Add(src,17,{4465});     // DenormFlushToZero
+    Add(src,17,{4466});     // SignedZeroInfNanPreserve
+    AddFloatExtension(src);
+    Add(src,14,{0,1});
+    Add(src,16,{60,17,32,32,1});
+    Add(src,16,{60,4460,32});
+    Add(src,16,{60,4461,32});
+    Add(src,19,{1});
+    Words variant;
+    assert(DropExplicitFloatControls(src,variant));
+    assert(variant.size() < src.size());
+    assert(std::equal(src.begin(),src.begin()+5,variant.begin()));
+    assert(Has(variant,17,1) && Has(variant,17,44));
+    assert(!Has(variant,17,4465) && !Has(variant,17,4466));
+    assert(Has(variant,16,60));   // local size remains unchanged
+    assert(variant[variant.size()-2] == 0x20013 && variant.back() == 1);
+    Words second;
+    assert(!DropExplicitFloatControls(variant,second)); // no flags left
+    Words malformed=src;
+    malformed[5]=0;
+    assert(!DropExplicitFloatControls(malformed,variant));
+    Words unsupported=src;
+    unsupported.insert(unsupported.begin()+5,{0x20011,4464});
+    assert(!DropExplicitFloatControls(unsupported,variant));
+    std::puts("Qualcomm float mode fallback: valid pattern, unchanged workgroup, unsupported modes rejected");
+}
diff --git a/gow3_pc/tests/test_tlou_qualcomm_image1d_compat.cpp b/gow3_pc/tests/test_tlou_qualcomm_image1d_compat.cpp
new file mode 100644
index 0000000..3c159a6
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_qualcomm_image1d_compat.cpp
@@ -0,0 +1,62 @@
+// Standalone regression for TLOU Qualcomm shader 0x4a705408 (ZIP 33).
+// The real module is 6020 bytes; verify its exact 1D image-write pattern
+// using the same instruction IDs without bundling proprietary game bytes.
+#include "../gpu/shadps4/video_core/renderer_vulkan/vk_qualcomm_image1d_compat.h"
+#include <algorithm>
+#include <cassert>
+#include <cstdio>
+#include <vector>
+
+using Vulkan::QualcommImage1DCompat::NarrowNonArrayed1DWrite;
+using Vulkan::QualcommImage1DCompat::DropUnusedImageReadCapability;
+using Words = std::vector<uint32_t>;
+static void Add(Words& v,uint32_t op,std::initializer_list<uint32_t> p) {
+    v.push_back((uint32_t(p.size()+1)<<16)|op);
+    v.insert(v.end(),p.begin(),p.end());
+}
+int main() {
+    Words source={0x07230203,0x00010600,0,0xd7,0};
+    Add(source,17,{55});   // UNUSED StorageImageReadWithoutFormat
+    Add(source,17,{56});   // REQUIRED StorageImageWriteWithoutFormat
+    Add(source,21,{10,32,0});                    // OpTypeInt %10 32 0
+    Add(source,23,{14,10,2});                    // OpTypeVector %14 %10 2
+    Add(source,25,{56,8,1,0,0,0,2,0});          // image1D, nonarrayed, storage
+    Add(source,61,{56,214,58});                 // OpLoad image %214
+    Add(source,80,{14,211,89,90});              // vec2 coordinate %211=(%89,%90)
+    Add(source,99,{214,211,213,0});             // OpImageWrite %214 %211 %213
+    Words dropped, patched;
+    assert(DropUnusedImageReadCapability(source,dropped));
+    assert(dropped.size()+2==source.size());
+    assert(dropped[5]==(2u<<16|17u) && dropped[6]==56u);
+    assert(!DropUnusedImageReadCapability(dropped,patched));
+    Words bad_read=source;
+    Add(bad_read,98,{56,89}); // image read instruction means capability is required
+    assert(!DropUnusedImageReadCapability(bad_read,patched));
+    assert(NarrowNonArrayed1DWrite(source,patched));
+    assert(source.size()==patched.size());
+    size_t changes=0;
+    for(size_t i=0;i<source.size();++i)
+        if(source[i]!=patched[i]) {
+            assert(source[i]==211 && patched[i]==89);
+            ++changes;
+        }
+    assert(changes==1);
+    Words rejected=source;
+    // Arrayed image: second component is layer, cannot drop it.
+    // Locate and toggle only the OpTypeImage Arrayed literal.
+    for(size_t i=5;i<rejected.size();i+=rejected[i]>>16)
+        if((rejected[i]&0xffff)==25) {rejected[i+5]=1;break;}
+    assert(!NarrowNonArrayed1DWrite(rejected,patched));
+    rejected=source;
+    for(size_t i=5;i<rejected.size();i+=rejected[i]>>16)
+        if((rejected[i]&0xffff)==25) {rejected[i+3]=2;break;}
+    assert(!NarrowNonArrayed1DWrite(rejected,patched)); // 2D needs Y
+    rejected=source;
+    for(size_t i=5;i<rejected.size();i+=rejected[i]>>16)
+        if((rejected[i]&0xffff)==99) {rejected[i+1]=215;break;}
+    assert(!NarrowNonArrayed1DWrite(rejected,patched));
+    rejected=source;
+    rejected.back()=1; // nonzero image operands mask
+    assert(!NarrowNonArrayed1DWrite(rejected,patched));
+    std::puts("Qualcomm image capability/1D fallback: unused read capability removed, exactly one coordinate word changed");
+}
diff --git a/gow3_pc/tests/test_tlou_qualcomm_vulkan_fallback.cpp b/gow3_pc/tests/test_tlou_qualcomm_vulkan_fallback.cpp
new file mode 100644
index 0000000..679ac70
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_qualcomm_vulkan_fallback.cpp
@@ -0,0 +1,34 @@
+// Android Qualcomm external-driver compatibility: keep user-selected Turnip
+// failures explicit, but recover from an incompatible vendor Vulkan HAL by
+// loading the Android system's Vulkan entry point. Run as separate processes
+// because the runtime intentionally caches the selected ICD with call_once.
+#include "../gpu/shim/vk_driver_loader.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+int main(int argc, char** argv) {
+    if (argc != 2) return 2;
+    const bool vendor = std::strcmp(argv[1], "vendor") == 0;
+    const bool turnip = std::strcmp(argv[1], "turnip") == 0;
+    const bool system = std::strcmp(argv[1], "system") == 0;
+    if (!vendor && !turnip && !system) return 2;
+    if (vendor) {
+        setenv("GOW3_VULKAN_DRIVER", "/missing/qcom/vulkan.adr891.so", 1);
+    } else if (turnip) {
+        setenv("GOW3_VULKAN_DRIVER", "/missing/mesa/libvulkan_freedreno.so", 1);
+    } else {
+        unsetenv("GOW3_VULKAN_DRIVER");
+    }
+    auto proc = gow3_vk_get_instance_proc_addr();
+    const bool expected = !turnip; // CI has the system Vulkan loader.
+    if ((proc != nullptr) != expected) {
+        std::fprintf(stderr, "Expected Vulkan entry %s, got %p for mode %s\n",
+                     expected ? "present" : "absent",
+                     reinterpret_cast<void*>(proc), argv[1]);
+        return 1;
+    }
+    std::printf("TLOU Vulkan %s: %s\n", argv[1], expected ? "system loader" : "hard failure");
+    return 0;
+}
diff --git a/gow3_pc/tests/test_tlou_readback_watch_gate.cpp b/gow3_pc/tests/test_tlou_readback_watch_gate.cpp
new file mode 100644
index 0000000..5920b7d
--- /dev/null
+++ b/gow3_pc/tests/test_tlou_readback_watch_gate.cpp
@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// AOT TLOU: GPU readback watcher sweep must retain exact submission semantics.
+#include "../gpu/shadps4/video_core/buffer_cache/tlou_readback_watch_gate.h"
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <vector>
+struct R {std::uint64_t tick; bool watched=false;};
+static void sweep(std::vector<R>& v,std::uint64_t now) {
+    for(auto& x:v) if(!x.watched && x.tick < now) x.watched=true;
+}
+int main() {
+    VideoCore::Detail::TlouReadbackWatchSweepGate gate;
+    std::vector<R> baseline, fast;
+    std::uint64_t legacy_visits=0, fast_visits=0;
+    // 240 submissions, 600 draw polls between them, 3 async readbacks each.
+    // New readbacks get exactly the CurrentTick() at queue time.
+    for(std::uint64_t tick=20;tick<260;++tick) {
+        for(int event=0;event<600;++event) {
+            if(event==0 || event==170 || event==499) {
+                baseline.push_back({tick});fast.push_back({tick});
+            }
+            legacy_visits+=baseline.size();
+            sweep(baseline,tick);
+            if(gate.ShouldSweep(tick)) {
+                fast_visits+=fast.size();
+                sweep(fast,tick);
+            }
+            assert(baseline.size()==fast.size());
+            for(size_t i=0;i<baseline.size();++i) assert(baseline[i].watched==fast[i].watched);
+            if(event%100==0 && baseline.size()>40) {
+                baseline.erase(baseline.begin(),baseline.begin()+3);
+                fast.erase(fast.begin(),fast.begin()+3);
+            }
+        }
+    }
+    // Previously queued readbacks become protected at the next tick.
+    assert(fast_visits < legacy_visits/100);
+    assert(!gate.ShouldSweep(259));
+    assert(gate.ShouldSweep(260));
+    std::printf("TLOU readback sweep: comparisons %llu -> %llu (%.2f%% fewer); exact watch state, poll/landing untouched\n",
+        (unsigned long long)legacy_visits,(unsigned long long)fast_visits,
+        100.0*(1.0-double(fast_visits)/double(legacy_visits)));
+}
