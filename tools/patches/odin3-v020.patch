+                    hashlib.sha256(bytes(reversed(range(mod.TLOU_111_SECOND_SWITCH_SIGNATURE_LEN)))).hexdigest()):
+                targets = mod.known_switch_entries(boot, mod.TLOU_111_SWITCH_SHA256)
