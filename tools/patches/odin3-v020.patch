+    if (result != vk::Result::eSuccess) {
+        std::fprintf(stderr, "Qualcomm compute FP fallback: alternate SPIR-V "
+                             "also rejected shader=%016llx result=%s\n",
+                     static_cast<unsigned long long>(shader_hash),
+                     vk::to_string(result).c_str());
