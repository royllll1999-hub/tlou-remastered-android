+        if(!compiler.isFile() || !bundle.isDirectory() || !frontend.isFile())
+            throw new IOException("Compilador ARM64 não incluído nesta APK");
+        if(progress!=null)progress.accept("Preparando compilação ARM64 otimizada.");
