+        }
+        std::fprintf(stderr,
+                     "Qualcomm compute image compatibility: rejected (%s) shader=%016llx: %s\n",
+                     candidate.description, static_cast<unsigned long long>(shader_hash),
+                     vk::to_string(result).c_str());
+    }
+    return false;
+}
