+++ b/android/bionic/build_aot_cpu.sh
@@ -0,0 +1,72 @@
+#!/usr/bin/env bash
+# Build the only production ARM64 CPU backend (native AOT, no FEX runtime).
+# GPL-2.0-or-later code from Bloodborne-Android (pinned upstream revision).
+set -Eeuo pipefail
+cd "$(dirname "$0")/../.."
+root=$PWD
+ndk=${TLOU_NDK:-${ANDROID_NDK_HOME:-$root/.local-deps/android/sdk/ndk/android-ndk-r29}}
+api=${TLOU_ANDROID_API:-30}
+llvm="$ndk/toolchains/llvm/prebuilt/linux-x86_64/bin"
+cc="$llvm/aarch64-linux-android${api}-clang++"
+readelf=$(command -v readelf)
+[[ -x $cc && -x $readelf ]] || { echo "AOT backend requires Android NDK: $ndk" >&2; exit 2; }
+pin=b6d4cfb6972c84d4029f54765406ec143df3c30e
+repo="$root/.local-deps/Bloodborne-Android-AOT"
+if [[ ! -d "$repo/.git" ]]; then
+  mkdir -p "$repo"
+  git -C "$repo" init -q
+  git -C "$repo" remote add origin https://github.com/ducvd89/Bloodborne-Android.git
+  git -C "$repo" sparse-checkout init --cone
+  git -C "$repo" sparse-checkout set cpu src/guest_cpu.h
+fi
+if [[ $(git -C "$repo" rev-parse HEAD 2>/dev/null || echo missing) != "$pin" ]]; then
+  git -C "$repo" fetch --depth=1 origin "$pin"
+  git -C "$repo" checkout --detach -f FETCH_HEAD
+fi
+test "$(git -C "$repo" rev-parse HEAD)" = "$pin"
+out="$root/out/android-bionic/aot-backend"
+python3 android/aot/port_runtime.py --upstream "$repo" --out "$out/src"
+echo "AOT toolchain: $cc"
+"$cc" --version | head -2
+echo "Compiling TLOU AOT C++ host dispatcher and fiber bridge"
+"$cc" -std=c++20 -O2 -g -Wall -Wextra -Werror -fPIC -shared \
+  -fvisibility=hidden -fvisibility-inlines-hidden -fno-strict-aliasing \
+  -I "$out/src" -I "$root/gow3_pc/src" \
+  "$root/android/aot/affinity_name_interpose.cpp" \
+  "$out/src/guest_cpu_aot.cpp" "$out/src/guest_cpu_native.cpp" \
+  "$out/src/host_call_arm64.S" \
+  -Wl,-soname,libgow3cpu.so -Wl,--no-undefined -ldl -lm \
+  -v -o "$out/libgow3cpu.so"
+readelf --dyn-syms --wide "$out/libgow3cpu.so" | grep -F pthread_setname_np
+echo "TLOU AOT dispatcher binary produced (AOT-only affinity hook included)"
+# The generated libtlouaot.so is intentionally DT_NEEDED on
+# libbbcpu.so, which Bloodborne uses to expose bbr_* dispatcher callbacks.
+# TLOU's probe, however, is DT_NEEDED on libgow3cpu.so. Provide a linker shim:
+# libtlouaot.so -> libbbcpu.so -> libgow3cpu.so (same running CPU engine).
+"$llvm/aarch64-linux-android${api}-clang" -shared -nostdlib   -Wl,-soname,libbbcpu.so -Wl,--no-as-needed   -L "$out" -lgow3cpu -o "$out/libbbcpu.so"
+"$readelf" -d "$out/libbbcpu.so" | grep -F '[libgow3cpu.so]'
+"$readelf" -h "$out/libgow3cpu.so" | grep -Eq 'Machine:.*AArch64'
+"$readelf" -d "$out/libgow3cpu.so" | grep -F '[libc.so]'
+"$readelf" --dyn-syms --wide "$out/libgow3cpu.so" > "$out/symbols.txt"
+for symbol in guest_cpu_init guest_cpu_code guest_cpu_call \
+    guest_cpu_fiber_create guest_cpu_fiber_save guest_cpu_fiber_entry \
+    guest_cpu_fiber_switch guest_cpu_fiber_dispose guest_cpu_fiber_frame_pointer \
+    guest_cpu_host_function guest_cpu_hook guest_cpu_tsc \
+    bbr_dispatch bbr_dispatch_tail bbr_dirty_entry bbr_unwound; do
+  grep -Eq "[[:space:]]${symbol}\$" "$out/symbols.txt" || {
+    echo "AOT runtime missing required exported symbol $symbol" >&2
+    exit 1
+  }
+done
+# The Android executable and the AOT-compiled guest must share this same
+# libgow3cpu.so: never link a separate FEX JIT implementation into gow3-probe.
+production="$root/out/android-bionic"
+mkdir -p "$production/lib" "$production/apk-assets/runtime-aot"
+cp "$out/libgow3cpu.so" "$production/lib/libgow3cpu.so"
+cp "$out/libgow3cpu.so" "$production/apk-assets/runtime-aot/libgow3cpu.so"
+cp "$out/libbbcpu.so" "$production/apk-assets/runtime-aot/libbbcpu.so"
+cp "$ndk/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android/libc++_shared.so" "$production/lib/libc++_shared.so"
+cmp "$production/lib/libgow3cpu.so" "$production/apk-assets/runtime-aot/libgow3cpu.so"
+sha256sum "$out/libgow3cpu.so" > "$out/libgow3cpu.so.sha256"
+sha256sum "$out/libbbcpu.so" > "$out/libbbcpu.so.sha256"
+echo "TLOU native AOT engine built and installed as the sole CPU runtime (no FEX JIT)."
